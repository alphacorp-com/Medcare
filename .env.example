# PostgreSQL connection. The application schema is tenant_template.
DATABASE_URL=postgresql://postgres:password@localhost:5432/medcarev2_db?schema=tenant_template

# Signs the sessions and derives the key encrypting the stored DHIS2 / Mobile Money
# credentials. Required in production (the app refuses to start without it). Generate once
# with `openssl rand -base64 32` and never change it afterwards: the stored credentials would
# become unreadable.
NEXTAUTH_SECRET=""

# Protects the scheduled DHIS2 push (GET /api/cron/sync-dhis2): the caller must send
# `Authorization: Bearer <CRON_SECRET>`. Unset = the endpoint is open — set it in production.
CRON_SECRET=

# On-prem license activation (hybrid online/offline flow with AlphaCorp) -----

# Per-client credential issued once by AlphaCorp when this site's LicenseClient
# is created in the AlphaCorp admin. Used as the Bearer credential for
# online activation, as the HMAC key for signing offline request files, AND
# as the gate on /setup (see app/api/v1/setup/route.ts) — the first person
# to enter this secret there becomes this install's first admin. Paste
# these in at deployment time — this is the one manual step that replaces
# a physical site visit.
ONPREM_LICENSE_CLIENT_ID=
ONPREM_LICENSE_CLIENT_SECRET=

# Stable identifier for this install's license binding (the "fingerprint"
# shown in Settings). Leave unset on a regular server/PC — the OS machine id
# is used. SET IT for Docker/Kubernetes/cloud deployments, where hostname and
# MAC change whenever the container is recreated (any random value, e.g.
# `openssl rand -hex 16`, generated once and never changed afterwards).
ONPREM_INSTALL_ID=

# Base URL of AlphaCorp's online activation endpoint, e.g.
# https://alphacorp.example.com/api/license/activate
# Leave unset if this site has no outbound internet access — the offline
# request/import flow works without it.
ALPHACORP_LICENSE_API_URL=

# Optional override of the embedded Ed25519 public key used to verify
# license tokens (see lib/onprem-license/public-key.ts) — only needed after
# a key rotation, before a redeploy ships the new default.
ONPREM_LICENSE_PUBLIC_KEY_PEM=

# Docker Compose only (docker-compose.yml) -----------------------------------
# Password of the bundled PostgreSQL container. Choose a strong one; the app container
# builds its DATABASE_URL from it.
POSTGRES_PASSWORD=
