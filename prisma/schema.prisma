// Replaces the previously hardcoded lib/laboratory/panels.ts (LAB_PANELS) and
// lib/radiology/catalog.ts (RADIOLOGY_CATALOG) — one entry here is one panel (lab) or
// one exam (radiology), differentiated by the parent ExamCatalogType.domain.
model ExamCatalogEntry {
  id                   String   @id @default(uuid()) @db.Uuid
  tenantId             String?  @map("tenant_id") @db.Uuid
  examTypeId           String   @map("exam_type_id") @db.Uuid
  code                 String   @db.VarChar(60)
  nameFr               String   @map("name_fr") @db.VarChar(255)
  nameEn               String?  @map("name_en") @db.VarChar(255)
