  // "Aide ponctuelle / dépannage": a patient of another site served once.
  isEmergencySupply   Boolean  @default(false) @map("is_emergency_supply")
  tbScreened          Boolean  @default(false) @map("tb_screened")
  tbSymptomsPositive  Boolean  @default(false) @map("tb_symptoms_positive")
  tbTested            Boolean  @default(false) @map("tb_tested")
