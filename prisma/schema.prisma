enum ScreeningTestType {
  hiv
  hiv_pcr
  syphilis
  hbsag
  hcv
  hdv
  chlamydia
  mycoplasma
  gonorrhea
  other_sti

  @@schema("tenant_template")
}

enum ScreeningResult {
  positive
  negative
  indeterminate
  invalid

  @@schema("tenant_template")
}

// Where the person was tested / enrolled ("porte d'entrée").
enum ScreeningEntryPoint {
  index_case
  emergency
  antenatal
  maternity
  postnatal
  pediatric
  inpatient
  outpatient
  vct
  tb
  sti
  family_planning
  community
  other

  @@schema("tenant_template")
}

enum ReferralSource {
  none
  asc
  obc

  @@schema("tenant_template")
}

// One screening test (rapid test, lab test, PCR): the register the RMA3 counts. Created by
// hand (tests done outside the lab) or from a validated lab result (examResultId, unique:
// a result never feeds the register twice).
model ScreeningTest {
  id                   String              @id @default(uuid()) @db.Uuid
  tenantId             String              @map("tenant_id") @db.Uuid
  patientId            String              @map("patient_id") @db.Uuid
  testType             ScreeningTestType   @map("test_type")
  testedAt             DateTime            @map("tested_at") @db.Timestamptz
  result               ScreeningResult
  entryPoint           ScreeningEntryPoint @map("entry_point")
  // A re-test of someone previously tested negative (e.g. HIV at ANC 2-4, at delivery).
  isRetest             Boolean             @default(false) @map("is_retest")
  resultCollectedAt    DateTime?           @map("result_collected_at") @db.Timestamptz
  // Test during this pregnancy, or of the partner of this pregnant woman.
  pregnancyId          String?             @map("pregnancy_id") @db.Uuid
  partnerOfPregnancyId String?             @map("partner_of_pregnancy_id") @db.Uuid
  referralSource       ReferralSource      @default(none) @map("referral_source")
  // Treatment of a positive syphilis / STI test.
  treatedAt            DateTime?           @map("treated_at") @db.Timestamptz
  examResultId         String?             @unique @map("exam_result_id") @db.Uuid
  notes                String?             @db.VarChar(500)
  recordedById         String              @map("recorded_by_id") @db.Uuid
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([tenantId, testedAt])
  @@index([patientId, testType])
  @@index([pregnancyId])
  @@map("screening_tests")
  @@schema("tenant_template")
}

