// Append-only, like DrugDispensing — antigenCode/antigenName are denormalized
// from the reference-catalog row (catalogType=vaccine_antigen) at write time
// so historical doses stay stable if the catalog entry is later renamed.
model Immunization {
  id                        String    @id @default(uuid()) @db.Uuid
  tenantId                  String?   @map("tenant_id") @db.Uuid
  patientId                 String    @map("patient_id") @db.Uuid
  antigenCode               String    @map("antigen_code") @db.VarChar(40)
  antigenName               String    @map("antigen_name") @db.VarChar(150)
  doseNumber                Int       @default(1) @map("dose_number")
  administeredAt            DateTime  @default(now()) @map("administered_at") @db.Timestamptz
  administeredById          String    @map("administered_by_id") @db.Uuid
  ageInDaysAtAdministration Int       @map("age_in_days_at_administration")
  lotNumber                 String?   @map("lot_number") @db.VarChar(60)
  expiryDate                DateTime? @map("expiry_date") @db.Date
  // RMA3 III.2 / III.3 breakdowns: where the dose was given (fixed post or outreach /
  // mobile strategy) and the population status of the child at that time.
  strategy                  VaccinationStrategy @default(fixed)
  populationGroup           PopulationGroup     @default(general) @map("population_group")
  // Session the dose was given in (optional; its strategy then applies).
  sessionId                 String?   @map("session_id") @db.Uuid
  // The stock lot the dose was taken from (null for antigens not managed in stock), and the
  // opened vial for multi-dose vaccines.
  stockLotId                String?   @map("stock_lot_id") @db.Uuid
  stockOpenVialId           String?   @map("stock_open_vial_id") @db.Uuid
  isOutOfSchedule           Boolean   @default(false) @map("is_out_of_schedule")
  notes                     String?

  patient       Patient             @relation(fields: [patientId], references: [id])
  stockLot      StockLot?           @relation(fields: [stockLotId], references: [id])
  stockOpenVial StockOpenVial?      @relation(fields: [stockOpenVialId], references: [id])
  session       VaccinationSession? @relation(fields: [sessionId], references: [id])
  aefiReports   AefiReport[]
  antenatalVisit AntenatalVisit?

  @@index([tenantId])
  @@index([patientId, administeredAt(sort: Desc)])
  @@index([antigenCode])
  @@map("immunizations")
  @@schema("tenant_template")
}

