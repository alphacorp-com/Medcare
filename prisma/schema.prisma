generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema", "views", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  schemas    = ["public", "tenant_template"]
  extensions = [uuidOssp(map: "uuid-ossp")]
}

// =============================================================================
// 2. ENUMS
// =============================================================================

enum TenantStatus {
  trial
  active
  suspended
  churned

  @@schema("public")
}

enum TenantType {
  hospital
  clinic
  ehpad
  lab
  specialized

  @@schema("public")
}

enum SubscriptionStatus {
  trial
  active
  past_due
  cancelled

  @@schema("public")
}

enum BillingCycle {
  monthly
  annual
  perpetual

  @@schema("public")
}

enum PlanTier {
  core
  clinical
  advanced
  enterprise

  @@schema("public")
}

enum ModuleCategory {
  clinical
  admin
  finance
  analytics
  integration
  hr

  @@schema("public")
}

enum ModuleStatus {
  active
  suspended
  trial
  pending

  @@schema("public")
}

enum InvoiceStatus {
  draft
  open
  paid
  void
  uncollectible

  @@schema("public")
}

enum OneTimeChargeType {
  implementation
  training
  integration
  migration
  custom
  support

  @@schema("public")
}

enum OneTimeChargeStatus {
  pending
  invoiced
  paid
  cancelled

  @@schema("public")
}

enum AuditActorType {
  admin
  tenant_user
  system
  api

  @@schema("public")
}

enum LicenseKeyStatus {
  generated
  redeemed
  revoked
  expired

  @@schema("public")
}

// Tenant-side enums
enum Gender {
  M
  F
  U

  @@schema("tenant_template")
}

enum StayType {
  emergency
  scheduled
  day_care
  outpatient

  @@schema("tenant_template")
}

enum StayStatus {
  pre_admission
  in_progress
  discharged
  transferred
  deceased

  @@schema("tenant_template")
}

// Declaration order is significant: it drives the ascending sort used by the
// triage queue (`ORDER BY triage_acuity ASC`), most critical first.
enum TriageAcuity {
  resuscitation
  emergent
  urgent
  less_urgent
  non_urgent

  @@schema("tenant_template")
}

// Tracks a Stay's progress through the doctor's consultation queue, independent of
// StayStatus (which stays "in_progress" the whole time) — so adding this never changes
// what any existing `status: "in_progress"` filter across admissions/KPIs/dashboard sees.
// awaiting_payment: the admission's medical act is billed but not yet settled — the
// patient only reaches "waiting" (and the doctor's queue) once the cashier records it
// (see lib/billing/paymentGate.ts).
enum ConsultationStatus {
  awaiting_payment
  waiting
  claimed
  completed

  @@schema("tenant_template")
}

// Hospitalisation decided after the consultation: the bed is reserved while the
// hospitalisation act is awaiting payment, and occupied once it's paid (see
// lib/billing/paymentGate.ts).
enum HospitalizationStatus {
  awaiting_payment
  admitted

  @@schema("tenant_template")
}

enum AppointmentStatus {
  booked
  confirmed
  checked_in
  completed
  no_show
  cancelled

  @@schema("tenant_template")
}

enum MedicalRecordType {
  consultation
  // Added after the consultation note is signed (e.g. once exam results come back).
  complementary_note
  observation
  surgery_report
  discharge_letter
  referral
  nursing_note
  anesthesia
  antenatal_note
  delivery_report

  @@schema("tenant_template")
}

enum PrescriptionStatus {
  pending
  validated
  dispensed
  cancelled
  expired

  @@schema("tenant_template")
}

enum ExamType {
  biology
  radiology
  pathology
  cardiology
  other

  @@schema("tenant_template")
}

enum ExamUrgency {
  stat
  urgent
  routine

  @@schema("tenant_template")
}

// awaiting_payment: a lab/radiology exam billed at prescription whose invoice is not yet
// settled — the lab/radiology workflow (collect, schedule…) only starts at "requested".
enum ExamRequestStatus {
  awaiting_payment
  requested
  scheduled
  in_progress
  completed
  cancelled

  @@schema("tenant_template")
}

enum SurgicalStatus {
  scheduled
  in_progress
  completed
  cancelled
  postponed

  @@schema("tenant_template")
}

enum DispensingStatus {
  dispensed
  administered
  refused
  wasted

  @@schema("tenant_template")
}

enum ShiftType {
  morning
  afternoon
  night
  on_call
  off

  @@schema("tenant_template")
}

enum ScheduleStatus {
  planned
  confirmed
  modified
  absent
  replaced

  @@schema("tenant_template")
}

enum BillingSourceType {
  consultation
  hospitalization
  exam
  surgery
  pharmacy_dispensation
  antenatal_visit
  delivery
  other

  @@schema("tenant_template")
}

enum BillingInvoiceStatus {
  draft
  pending_payment
  partially_paid
  paid
  cancelled

  @@schema("tenant_template")
}

enum PaymentMethod {
  cash
  card
  // Overpayment of another invoice of the same patient moved here (PatientRefund kind transfer):
  // no new money, never counted as income.
  credit_transfer
  insurance
  mobile_money_orange
  mobile_money_mtn
  bank_transfer

  @@schema("tenant_template")
}

enum PaymentStatus {
  pending
  successful
  failed
  cancelled

  @@schema("tenant_template")
}

enum AdverseEventType {
  medication_error
  fall
  infection
  procedure_complication
  equipment_failure
  diagnostic_error
  other

  @@schema("tenant_template")
}

enum AdverseEventSeverity {
  minor
  moderate
  major
  catastrophic

  @@schema("tenant_template")
}

enum AdverseEventStatus {
  reported
  under_analysis
  action_plan
  closed

  @@schema("tenant_template")
}

enum DepartmentType {
  emergency
  surgery
  icu
  medicine
  pediatrics
  radiology
  laboratory
  pharmacy
  maternity
  admin
  other

  @@schema("tenant_template")
}

enum PregnancyStatus {
  ongoing
  delivered
  miscarried
  terminated

  @@schema("tenant_template")
}

enum DeliveryMode {
  vaginal
  assisted_vaginal
  cesarean

  @@schema("tenant_template")
}

// =============================================================================
// 3. PUBLIC SCHEMA — Plateforme
// =============================================================================

model Tenant {
  id           String       @id @default(uuid()) @db.Uuid
  slug         String       @unique @db.VarChar(60)
  name         String       @db.VarChar(255)
  type         TenantType
  countryCode  String       @default("CM") @map("country_code") @db.Char(2)
  timezone     String       @default("Africa/Douala") @db.VarChar(50)
  locale       String       @default("fr") @db.VarChar(10)
  dbSchema     String       @unique @map("db_schema") @db.VarChar(80)
  status       TenantStatus @default(trial)
  contactEmail String?      @map("contact_email") @db.VarChar(255)
  contactPhone String?      @map("contact_phone") @db.VarChar(30)
  address      String?
  logoUrl      String?      @map("logo_url")
  metadata     Json         @default("{}")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  suspendedAt  DateTime?    @map("suspended_at") @db.Timestamptz
  churnedAt    DateTime?    @map("churned_at") @db.Timestamptz

  // Relations
  settings           TenantSetting[]
  subscriptions      Subscription[]
  invoices           Invoice[]
  oneTimeCharges     OneTimeCharge[]
  tenantModules      TenantModule[]
  licenseKeys        LicenseKey[]
  auditLogs          AuditLog[]

  @@index([slug])
  @@index([status])
  @@index([dbSchema])
  @@map("tenants")
  @@schema("public")
}

model TenantSetting {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String   @db.VarChar(120)
  value     Json
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@map("tenant_settings")
  @@schema("public")
}

model Plan {
  id           String       @id @default(uuid()) @db.Uuid
  name         String       @db.VarChar(100)
  tier         PlanTier
  billingCycle BillingCycle @map("billing_cycle")
  basePrice    Decimal      @default(0) @map("base_price") @db.Decimal(12, 2)
  pricePerBed  Decimal?     @map("price_per_bed") @db.Decimal(8, 2)
  pricePerUser Decimal?     @map("price_per_user") @db.Decimal(8, 2)
  maxUsers     Int?         @map("max_users")
  maxBeds      Int?         @map("max_beds")
  maxStorageGb Int?         @map("max_storage_gb")
  currency     String       @default("XAF") @db.Char(3)
  features     Json         @default("{}")
  isActive     Boolean      @default(true) @map("is_active")
  isPublic     Boolean      @default(true) @map("is_public")
  sortOrder    Int          @default(0) @map("sort_order") @db.SmallInt
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  subscriptions Subscription[]
  planModules   PlanModule[]
  licenseKeys   LicenseKey[]

  @@map("plans")
  @@schema("public")
}

model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  tenantId           String             @map("tenant_id") @db.Uuid
  planId             String             @map("plan_id") @db.Uuid
  status             SubscriptionStatus @default(trial)
  trialEndsAt        DateTime?          @map("trial_ends_at") @db.Timestamptz
  currentPeriodStart DateTime           @default(now()) @map("current_period_start") @db.Timestamptz
  currentPeriodEnd   DateTime           @map("current_period_end") @db.Timestamptz
  cancelledAt        DateTime?          @map("cancelled_at") @db.Timestamptz
  cancelReason       String?            @map("cancel_reason")
  seatsCount         Int                @default(5) @map("seats_count")
  bedsCount          Int                @default(0) @map("beds_count")
  mrr                Decimal            @default(0) @map("mrr") @db.Decimal(12, 2)
  currency           String             @default("XAF") @db.Char(3)
  paymentMethod      String?            @map("payment_method") @db.VarChar(40)
  externalSubId      String?            @map("external_sub_id") @db.VarChar(120)
  notes              String?
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  plan        Plan         @relation(fields: [planId], references: [id])
  invoices    Invoice[]
  licenseKeys LicenseKey[]

  @@index([tenantId])
  @@index([status])
  @@index([currentPeriodEnd])
  @@map("subscriptions")
  @@schema("public")
}

model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  subscriptionId String        @map("subscription_id") @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  invoiceNumber  String        @unique @map("invoice_number") @db.VarChar(40)
  amountHt       Decimal       @map("amount_ht") @db.Decimal(12, 2)
  taxRate        Decimal       @default(0) @map("tax_rate") @db.Decimal(5, 2)
  currency       String        @default("XAF") @db.Char(3)
  status         InvoiceStatus @default(draft)
  dueDate        DateTime      @map("due_date") @db.Date
  paidAt         DateTime?     @map("paid_at") @db.Timestamptz
  invoicePdfUrl  String?       @map("invoice_pdf_url")
  lineItems      Json          @default("[]") @map("line_items")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz

  subscription   Subscription    @relation(fields: [subscriptionId], references: [id])
  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  oneTimeCharges OneTimeCharge[]

  @@index([tenantId])
  @@index([status])
  @@map("invoices")
  @@schema("public")
}

model OneTimeCharge {
  id          String              @id @default(uuid()) @db.Uuid
  tenantId    String              @map("tenant_id") @db.Uuid
  type        OneTimeChargeType
  description String
  amount      Decimal             @db.Decimal(12, 2)
  currency    String              @default("XAF") @db.Char(3)
  status      OneTimeChargeStatus @default(pending)
  invoiceId   String?             @map("invoice_id") @db.Uuid
  createdBy   String?             @map("created_by") @db.Uuid
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  invoice Invoice? @relation(fields: [invoiceId], references: [id])

  @@map("one_time_charges")
  @@schema("public")
}

model Module {
  id           String         @id @default(uuid()) @db.Uuid
  code         String         @unique @db.VarChar(60)
  name         String         @db.VarChar(150)
  tier         PlanTier
  category     ModuleCategory
  version      String         @default("1.0.0") @db.VarChar(20)
  description  String?
  changelog    Json           @default("[]")
  priceMonthly Decimal?       @map("price_monthly") @db.Decimal(10, 2)
  priceAnnual  Decimal?       @map("price_annual") @db.Decimal(10, 2)
  dependencies Json           @default("[]")
  configSchema Json           @default("{}") @map("config_schema")
  isPublished  Boolean        @default(false) @map("is_published")
  isBeta       Boolean        @default(false) @map("is_beta")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  planModules   PlanModule[]
  tenantModules TenantModule[]

  @@index([code])
  @@index([tier])
  @@map("modules")
  @@schema("public")
}

model PlanModule {
  id         String  @id @default(uuid()) @db.Uuid
  planId     String  @map("plan_id") @db.Uuid
  moduleId   String  @map("module_id") @db.Uuid
  isIncluded Boolean @default(true) @map("is_included")

  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([planId, moduleId])
  @@map("plan_modules")
  @@schema("public")
}

model TenantModule {
  id              String       @id @default(uuid()) @db.Uuid
  tenantId        String       @map("tenant_id") @db.Uuid
  moduleId        String       @map("module_id") @db.Uuid
  status          ModuleStatus @default(pending)
  activatedAt     DateTime?    @map("activated_at") @db.Timestamptz
  expiresAt       DateTime?    @map("expires_at") @db.Timestamptz
  activatedBy     String       @map("activated_by") @db.Uuid
  configOverrides Json         @default("{}") @map("config_overrides")
  notes           String?
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id])

  @@unique([tenantId, moduleId])
  @@index([tenantId])
  @@index([status])
  @@map("tenant_modules")
  @@schema("public")
}

model AuditLog {
  id           String         @id @default(uuid()) @db.Uuid
  tenantId     String?        @map("tenant_id") @db.Uuid
  actorId      String         @map("actor_id") @db.Uuid
  actorType    AuditActorType @map("actor_type")
  action       String         @db.VarChar(120)
  resourceType String?        @map("resource_type") @db.VarChar(80)
  resourceId   String?        @map("resource_id") @db.Uuid
  payload      Json?
  ipAddress    String?        @map("ip_address")
  userAgent    String?        @map("user_agent")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt(sort: Desc)])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
  @@schema("public")
}

model LicenseKey {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  planId         String           @map("plan_id") @db.Uuid
  subscriptionId String?          @map("subscription_id") @db.Uuid
  keyHash        String           @unique @map("key_hash") @db.VarChar(128)
  keyPreview     String           @map("key_preview") @db.VarChar(32)
  period         BillingCycle
  status         LicenseKeyStatus @default(generated)
  issuedBy       String?          @map("issued_by") @db.Uuid
  redeemedBy     String?          @map("redeemed_by") @db.Uuid
  redeemedAt     DateTime?        @map("redeemed_at") @db.Timestamptz
  validFrom      DateTime?        @map("valid_from") @db.Timestamptz
  validUntil     DateTime?        @map("valid_until") @db.Timestamptz
  revokedAt      DateTime?        @map("revoked_at") @db.Timestamptz
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan         Plan          @relation(fields: [planId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([tenantId, status])
  @@index([subscriptionId])
  @@index([validUntil])
  @@map("license_keys")
  @@schema("public")
}

// -----------------------------------------------------------------------------
// On-premise install licensing (separate from the multi-tenant SaaS licensing
// above — this install has no shared DB with AlphaCorp, so licenses are issued
// remotely and applied here as a signed token). Single mutable row: this
// install has exactly one currently-applied license at a time.
// -----------------------------------------------------------------------------
model OnPremLicense {
  id              String   @id @default("current")
  token           String   @map("token") @db.Text
  jti             String   @map("jti")
  clientId        String   @map("client_id")
  tier            String   @map("tier")
  modules         String[] @map("modules")
  maxUsers        Int?     @map("max_users")
  maxBeds         Int?     @map("max_beds")
  validFrom       DateTime @map("valid_from") @db.Timestamptz
  validUntil      DateTime @map("valid_until") @db.Timestamptz
  gracePeriodDays Int      @map("grace_period_days")
  fingerprint     String   @map("fingerprint")
  channel         String   @map("channel")
  appliedAt       DateTime @default(now()) @map("applied_at") @db.Timestamptz
  lastKnownGoodAt DateTime @map("last_known_good_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("onprem_license")
  @@schema("public")
}

// =============================================================================
// 4. TENANT SCHEMA — Données métier (schema_template)
// =============================================================================

model Patient {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String?   @map("tenant_id") @db.Uuid
  ipp               String    @db.VarChar(20)
  lastName          String    @map("last_name") @db.VarChar(120)
  firstName         String    @map("first_name") @db.VarChar(120)
  maidenName        String?   @map("maiden_name") @db.VarChar(120)
  birthDate         DateTime  @map("birth_date") @db.Date
  birthPlace        String?   @map("birth_place") @db.VarChar(120)
  gender            Gender
  nationality       String    @default("CM") @db.Char(2)
  maritalStatus     String?   @map("marital_status") @db.VarChar(20)
  bloodGroup        String?   @map("blood_group") @db.VarChar(5)
  nss               String?   @unique @db.VarChar(30)
  phone             String?   @db.VarChar(30)
  email             String?   @db.VarChar(255)
  address           String?
  emergencyContact  Json      @default("{}") @map("emergency_contact")
  allergies         Json      @default("[]")
  chronicConditions Json      @default("[]") @map("chronic_conditions")
  gdprConsent       Boolean   @default(false) @map("gdpr_consent")
  gdprConsentAt     DateTime? @map("gdpr_consent_at") @db.Timestamptz
  isDeceased        Boolean   @default(false) @map("is_deceased")
  deceasedAt        DateTime? @map("deceased_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  stays              Stay[]
  appointments       Appointment[]
  medicalRecords     MedicalRecord[]
  prescriptions      Prescription[]
  examRequests       ExamRequest[]
  examResults        ExamResult[]
  surgicalProcedures SurgicalProcedure[]
  drugDispensings    DrugDispensing[]
  invoices           PatientInvoice[]
  adverseEvents      AdverseEvent[]
  vitalSigns         VitalSigns[]
  pregnancies        Pregnancy[]
  newbornRecord      Newborn?
  immunizations      Immunization[]
  malariaCases       MalariaCase[]
  tbCases            TbCase[]
  diagnoses          Diagnosis[]
  screeningTests     ScreeningTest[]
  hivEnrolments      HivCareEnrolment[]
  viralLoads         ViralLoadResult[]
  hepatitisCases     HepatitisCase[]
  hivExposure        HivExposedInfant?
  artEmergencySupplies ArtEmergencySupply[]
  familyPlanningVisits FamilyPlanningVisit[]
  hypoxemiaEpisodes    HypoxemiaEpisode[]
  nutritionCases       NutritionCase[]
  growthVisits         GrowthMonitoringVisit[]
  tbScreenings         TbScreening[]
  chronicEnrolments    ChronicCareEnrolment[]
  drugAdverseReactions DrugAdverseReaction[]
  coverages            PatientCoverage[]
  heldPolicies         CoveragePolicy[]
  exemptions           PatientExemption[]

  @@unique([tenantId, ipp])
  @@index([tenantId])
  @@index([birthDate])
  @@index([tenantId, lastName, firstName, birthDate])
  @@map("patients")
  @@schema("tenant_template")
}

model Stay {
  id                 String             @id @default(uuid()) @db.Uuid
  tenantId           String?            @map("tenant_id") @db.Uuid
  patientId          String             @map("patient_id") @db.Uuid
  stayNumber         String             @map("stay_number") @db.VarChar(20)
  type               StayType
  status             StayStatus         @default(in_progress)
  admissionDate      DateTime           @default(now()) @map("admission_date") @db.Timestamptz
  dischargeDate      DateTime?          @map("discharge_date") @db.Timestamptz
  departmentId       String?            @map("department_id") @db.Uuid
  bedId              String?            @map("bed_id") @db.Uuid
  attendingDoctorId  String?            @map("attending_doctor_id") @db.Uuid
  admissionReason    String?            @map("admission_reason")
  // MedicalAct.code chosen at admission and billed right away (sourceType "consultation",
  // sourceId = this stay's id). Null for stays created before this existed or without an act.
  medicalActCode     String?            @map("medical_act_code") @db.VarChar(40)
  dischargeSummary   String?            @map("discharge_summary")
  pmsiCode           String?            @map("pmsi_code") @db.VarChar(20)
  pmsiValidated      Boolean            @default(false) @map("pmsi_validated")
  admissionTypeId    String?            @map("admission_type_id") @db.Uuid
  triageAcuity       TriageAcuity?      @map("triage_acuity")
  triagedAt          DateTime?          @map("triaged_at") @db.Timestamptz
  consultationStatus ConsultationStatus @default(waiting) @map("consultation_status")
  // RMA3 III.7-006 / III.8-002: consultation conducted per the national protocol (IMCI for
  // children, syndromic approach for STIs), ticked when the consultation is signed.
  followedNationalProtocol Boolean @default(false) @map("followed_national_protocol")
  // Pending until paid: the chosen bed is held as "reserved" and only becomes the stay's
  // bedId/departmentId once the hospitalisation act is settled.
  hospitalizationStatus       HospitalizationStatus? @map("hospitalization_status")
  hospitalizationActCode      String?                @map("hospitalization_act_code") @db.VarChar(40)
  hospitalizationDepartmentId String?                @map("hospitalization_department_id") @db.Uuid
  hospitalizationBedId        String?                @map("hospitalization_bed_id") @db.Uuid
  hospitalizationRequestedAt  DateTime?              @map("hospitalization_requested_at") @db.Timestamptz
  hospitalizedAt              DateTime?              @map("hospitalized_at") @db.Timestamptz
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  patient Patient @relation(fields: [patientId], references: [id])

  medicalRecords     MedicalRecord[]
  prescriptions      Prescription[]
  examRequests       ExamRequest[]
  surgicalProcedures SurgicalProcedure[]
  adverseEvents      AdverseEvent[]
  invoices           PatientInvoice[]
  vitalSigns         VitalSigns[]
  delivery           Delivery?
  diagnoses          Diagnosis[]

  @@unique([tenantId, stayNumber])
  @@index([tenantId])
  @@index([patientId])
  @@index([status])
  @@index([admissionDate(sort: Desc)])
  @@index([consultationStatus])
  @@map("stays")
  @@schema("tenant_template")
}

// A future-dated booking, distinct from Stay (which represents an actual physical
// visit already under way). Check-in (see /api/v1/appointments/[id]/check-in) creates
// a real Stay and links it back via stayId — from that point on the patient flows
// through the existing consultation queue / triage / billing pipeline unchanged, so
// nothing downstream of check-in needs to know appointments exist at all.
model Appointment {
  id                  String            @id @default(uuid()) @db.Uuid
  tenantId            String?           @map("tenant_id") @db.Uuid
  patientId           String            @map("patient_id") @db.Uuid
  doctorId            String            @map("doctor_id") @db.Uuid
  departmentId        String?           @map("department_id") @db.Uuid
  appointmentTypeCode String?           @map("appointment_type_code") @db.VarChar(40)
  scheduledAt         DateTime          @map("scheduled_at") @db.Timestamptz
  durationMinutes     Int               @default(30) @map("duration_minutes")
  status              AppointmentStatus @default(booked)
  reasonForVisit      String?           @map("reason_for_visit")
  notes               String?
  stayId              String?           @map("stay_id") @db.Uuid
  seriesId            String?           @map("series_id") @db.Uuid
  cancelledAt         DateTime?         @map("cancelled_at") @db.Timestamptz
  cancelledReason     String?           @map("cancelled_reason")
  createdBy           String?           @map("created_by") @db.Uuid
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([tenantId, doctorId, scheduledAt])
  @@index([tenantId, patientId])
  @@index([seriesId])
  @@index([status])
  @@map("appointments")
  @@schema("tenant_template")
}

// Recurring weekly availability window for a doctor's bookable appointment slots —
// distinct from Schedule (staff shift roster in the Planning module), which tracks who's
// on duty, not what's open for patient booking.
model DoctorAvailability {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String?  @map("tenant_id") @db.Uuid
  doctorId    String   @map("doctor_id") @db.Uuid
  weekday     Int      @db.SmallInt
  startTime   String   @map("start_time") @db.VarChar(5)
  endTime     String   @map("end_time") @db.VarChar(5)
  slotMinutes Int      @default(30) @map("slot_minutes")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([tenantId, doctorId, weekday])
  @@map("doctor_availabilities")
  @@schema("tenant_template")
}

model VitalSigns {
  id                     String   @id @default(uuid()) @db.Uuid
  tenantId               String?  @map("tenant_id") @db.Uuid
  patientId              String   @map("patient_id") @db.Uuid
  stayId                 String?  @map("stay_id") @db.Uuid
  recordedById           String   @map("recorded_by_id") @db.Uuid
  recordedAt             DateTime @default(now()) @map("recorded_at") @db.Timestamptz
  bloodPressureSystolic  Int?     @map("blood_pressure_systolic")
  bloodPressureDiastolic Int?     @map("blood_pressure_diastolic")
  pulse                  Int?
  temperature            Decimal? @db.Decimal(4, 1)
  weight                 Decimal? @db.Decimal(5, 2)
  height                 Decimal? @db.Decimal(5, 1)
  spo2                   Int?

  patient Patient @relation(fields: [patientId], references: [id])
  stay    Stay?   @relation(fields: [stayId], references: [id])

  @@index([patientId, recordedAt(sort: Desc)])
  @@index([stayId])
  @@index([tenantId])
  @@map("vital_signs")
  @@schema("tenant_template")
}

model Pregnancy {
  id                  String          @id @default(uuid()) @db.Uuid
  tenantId            String?         @map("tenant_id") @db.Uuid
  patientId           String          @map("patient_id") @db.Uuid
  lastMenstrualPeriod DateTime        @map("last_menstrual_period") @db.Date
  expectedDueDate     DateTime        @map("expected_due_date") @db.Date
  gravida             Int
  para                Int
  status              PregnancyStatus @default(ongoing)
  riskFactors         Json            @default("[]") @map("risk_factors")
  // Whether a community health worker / organization referred the woman (RMA3 II.3.3).
  referralSource      ReferralSource  @default(none) @map("referral_source")
  notes               String?
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  patient         Patient          @relation(fields: [patientId], references: [id])
  // End of a pregnancy that did not reach a delivery (miscarriage / termination), and the
  // post-abortion care given (RMA3 II.1.2-012 to 014).
  endedAt                 DateTime?           @map("ended_at") @db.Timestamptz
  abortionCare            AbortionCareType?   @map("abortion_care")
  // Maternal death (during pregnancy, at delivery or within 42 days), its cause in the RMA3
  // list and the date of its maternal death review (II.1.2-015 to 024).
  maternalDeathAt         DateTime?           @map("maternal_death_at") @db.Timestamptz
  maternalDeathCause      MaternalDeathCause? @map("maternal_death_cause")
  maternalDeathReviewedAt DateTime?           @map("maternal_death_reviewed_at") @db.Date

  antenatalVisits AntenatalVisit[]
  delivery        Delivery?
  examRequests    ExamRequest[]
  // HIV-sensitive: in its own table so the maternity routes never return it.
  pmtctStatus     PmtctPregnancyStatus?
  postnatalVisits PostnatalVisit[]

  @@index([tenantId])
  @@index([patientId])
  @@map("pregnancies")
  @@schema("tenant_template")
}

model AntenatalVisit {
  id                     String   @id @default(uuid()) @db.Uuid
  tenantId               String?  @map("tenant_id") @db.Uuid
  pregnancyId            String   @map("pregnancy_id") @db.Uuid
  visitNumber            Int      @map("visit_number")
  visitDate              DateTime @default(now()) @map("visit_date") @db.Timestamptz
  gestationalAgeWeeks    Int      @map("gestational_age_weeks")
  performedById          String   @map("performed_by_id") @db.Uuid
  bloodPressureSystolic  Int?     @map("blood_pressure_systolic")
  bloodPressureDiastolic Int?     @map("blood_pressure_diastolic")
  weight                 Decimal? @db.Decimal(5, 2)
  fundalHeightCm         Decimal? @map("fundal_height_cm") @db.Decimal(4, 1)
  fetalHeartRate         Int?     @map("fetal_heart_rate")
  ironFolateGiven        Boolean  @default(false) @map("iron_folate_given")
  tetanusVaccineGiven    Boolean  @default(false) @map("tetanus_vaccine_given")
  malariaPreventionGiven Boolean  @default(false) @map("malaria_prevention_given")
  // RMA3 IV.2.2-3-001: long-lasting insecticidal net (MILDA) given at the visit.
  itnGiven               Boolean  @default(false) @map("itn_given")
  notes                  String?

  // RMA3 II.1.1-005: visit at the fixed post or in outreach (strategie avancee).
  strategy               VaccinationStrategy @default(fixed)
  // II.1.1-020: haemoglobin measured at the visit (g/dL, point of care or lab result).
  hemoglobinGPerDl       Decimal?            @map("hemoglobin_g_per_dl") @db.Decimal(4, 1)
  // The Td dose given at this visit: an Immunization (the vaccination register is the source
  // of truth for the dose rank, lot and AEFI).
  tdImmunizationId       String?             @unique @map("td_immunization_id") @db.Uuid

  pregnancy      Pregnancy     @relation(fields: [pregnancyId], references: [id])
  tdImmunization Immunization? @relation(fields: [tdImmunizationId], references: [id])

  @@index([tenantId])
  @@index([pregnancyId, visitDate])
  @@map("antenatal_visits")
  @@schema("tenant_template")
}

model Delivery {
  id                String        @id @default(uuid()) @db.Uuid
  tenantId          String?       @map("tenant_id") @db.Uuid
  pregnancyId       String        @unique @map("pregnancy_id") @db.Uuid
  stayId            String?       @unique @map("stay_id") @db.Uuid
  deliveryDate      DateTime?     @map("delivery_date") @db.Timestamptz
  mode              DeliveryMode?
  attendedById      String?       @map("attended_by_id") @db.Uuid
  complications     Json          @default("[]")
  maternalOutcome   String?       @map("maternal_outcome")
  placentaDelivered Boolean       @default(false) @map("placenta_delivered")
  bloodLossMl       Int?          @map("blood_loss_ml")
  notes             String?
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz

  pregnancy  Pregnancy         @relation(fields: [pregnancyId], references: [id])
  stay       Stay?             @relation(fields: [stayId], references: [id])
  // RMA3 II.1.2: active management of the third stage (GATPA), complications managed on
  // site, and when breastfeeding started (II.1.2-025, III.9-001).
  amtsl                Boolean             @default(false)
  complicationsManaged Boolean             @default(false) @map("complications_managed")
  breastfeedingStart   BreastfeedingStart? @map("breastfeeding_start")

  partograph PartographEntry[]
  newborns   Newborn[]

  @@index([tenantId])
  @@map("deliveries")
  @@schema("tenant_template")
}

model PartographEntry {
  id                     String   @id @default(uuid()) @db.Uuid
  tenantId               String?  @map("tenant_id") @db.Uuid
  deliveryId             String   @map("delivery_id") @db.Uuid
  recordedAt             DateTime @default(now()) @map("recorded_at") @db.Timestamptz
  cervicalDilationCm     Int?     @map("cervical_dilation_cm")
  fetalHeartRate         Int?     @map("fetal_heart_rate")
  contractionsPer10Min   Int?     @map("contractions_per_10min")
  contractionDurationSec Int?     @map("contraction_duration_sec")
  maternalPulse          Int?     @map("maternal_pulse")
  maternalBpSystolic     Int?     @map("maternal_bp_systolic")
  maternalBpDiastolic    Int?     @map("maternal_bp_diastolic")
  amnioticFluid          String?  @map("amniotic_fluid")
  recordedById           String   @map("recorded_by_id") @db.Uuid

  delivery Delivery @relation(fields: [deliveryId], references: [id])

  @@index([deliveryId, recordedAt])
  @@map("partograph_entries")
  @@schema("tenant_template")
}

model Newborn {
  id                  String  @id @default(uuid()) @db.Uuid
  tenantId            String? @map("tenant_id") @db.Uuid
  deliveryId          String  @map("delivery_id") @db.Uuid
  patientId           String? @unique @map("patient_id") @db.Uuid
  sex                 Gender
  birthWeightGrams    Int?    @map("birth_weight_grams")
  apgarScore1Min      Int?    @map("apgar_score_1min")
  apgarScore5Min      Int?    @map("apgar_score_5min")
  vitaminKGiven       Boolean @default(false) @map("vitamin_k_given")
  resuscitationNeeded Boolean @default(false) @map("resuscitation_needed")
  outcome             String  @default("alive")
  notes               String?

  // RMA3 II.1.4: fresh / macerated stillbirth, bag-and-mask ventilation, kangaroo care,
  // incubator, and the neonatal death (date, cause, review).
  stillbirthType      StillbirthType?     @map("stillbirth_type")
  bagMaskVentilation  Boolean             @default(false) @map("bag_mask_ventilation")
  kangarooCare        Boolean             @default(false) @map("kangaroo_care")
  incubatorCare       Boolean             @default(false) @map("incubator_care")
  diedAt              DateTime?           @map("died_at") @db.Timestamptz
  deathCause          NeonatalDeathCause? @map("death_cause")
  deathReviewedAt     DateTime?           @map("death_reviewed_at") @db.Date

  delivery Delivery @relation(fields: [deliveryId], references: [id])
  patient  Patient? @relation(fields: [patientId], references: [id])

  @@map("newborns")
  @@schema("tenant_template")
}

model MedicalRecord {
  id            String            @id @default(uuid()) @db.Uuid
  tenantId      String?           @map("tenant_id") @db.Uuid
  patientId     String            @map("patient_id") @db.Uuid
  stayId        String?           @map("stay_id") @db.Uuid
  authorId      String            @map("author_id") @db.Uuid
  type          MedicalRecordType
  title         String?           @db.VarChar(255)
  content       String
  contentHtml   String?           @map("content_html")
  isSigned      Boolean           @default(false) @map("is_signed")
  signedAt      DateTime?         @map("signed_at") @db.Timestamptz
  signedBy      String?           @map("signed_by") @db.Uuid
  signatureHash String?           @map("signature_hash")
  attachments   Json              @default("[]")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  patient   Patient     @relation(fields: [patientId], references: [id])
  stay      Stay?       @relation(fields: [stayId], references: [id])
  diagnoses Diagnosis[]

  @@index([tenantId])
  @@map("medical_records")
  @@schema("tenant_template")
}

// Coded diagnoses (ICD-10). Recorded when a consultation note is signed, when a
// hospitalized stay is discharged, and as the cause of death when a stay ends with a
// death. They feed the RMA3 causes of consultation (V.3), hospitalization (V.4) and death
// (V.5) through Rma3DiagnosisRubric. `label` is a snapshot of the ICD-10 label at the time
// of recording, so later edits to the catalog don't rewrite history.
enum DiagnosisKind {
  principal
  secondary

  @@schema("tenant_template")
}

enum DiagnosisContext {
  consultation
  discharge
  death

  @@schema("tenant_template")
}

model Diagnosis {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String?          @map("tenant_id") @db.Uuid
  patientId       String           @map("patient_id") @db.Uuid
  stayId          String?          @map("stay_id") @db.Uuid
  medicalRecordId String?          @map("medical_record_id") @db.Uuid
  context         DiagnosisContext
  kind            DiagnosisKind
  icd10Code       String           @map("icd10_code") @db.VarChar(10)
  label           String           @db.VarChar(255)
  // New case (first diagnosis of this condition) vs follow-up of a known condition.
  isNewCase       Boolean          @default(true) @map("is_new_case")
  // Suspected, not confirmed (RMA3 II.2 "cas suspectés"): kept out of the new-case counts.
  isSuspected     Boolean          @default(false) @map("is_suspected")
  recordedById    String           @map("recorded_by_id") @db.Uuid
  recordedAt      DateTime         @default(now()) @map("recorded_at") @db.Timestamptz
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz

  patient       Patient        @relation(fields: [patientId], references: [id])
  stay          Stay?          @relation(fields: [stayId], references: [id])
  medicalRecord MedicalRecord? @relation(fields: [medicalRecordId], references: [id])

  @@index([tenantId, context, recordedAt])
  @@index([patientId])
  @@index([stayId])
  @@map("diagnoses")
  @@schema("tenant_template")
}

// Correspondence between ICD-10 codes and the RMA3 cause rubrics, editable by the
// administrator in Settings (seeded with a standard proposal, see
// lib/reports/rma3-rubrics-default.ts). `icd10Ranges` is a comma-separated list of codes
// and category ranges, e.g. "B50-B54" or "A39, G00", validated server-side.
model Rma3DiagnosisRubric {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String?  @map("tenant_id") @db.Uuid
  // RMA3 table: "V.3" (consultation), "V.4" (hospitalization), "V.5" (death).
  section     String   @db.VarChar(10)
  // Indicator code of the RMA3 dictionary, e.g. "RMA3-V.3-001".
  code        String   @db.VarChar(30)
  label       String   @db.VarChar(255)
  icd10Ranges String   @default("") @map("icd10_ranges")
  order       Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  updatedById String?  @map("updated_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([tenantId, code])
  @@index([tenantId, section])
  @@map("rma3_diagnosis_rubrics")
  @@schema("tenant_template")
}

model Prescription {
  id                    String             @id @default(uuid()) @db.Uuid
  tenantId              String?            @map("tenant_id") @db.Uuid
  patientId             String             @map("patient_id") @db.Uuid
