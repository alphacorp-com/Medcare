  parameters           Json     @default("[]")
  imagingCatalogItemId String?  @map("imaging_catalog_item_id") @db.Uuid
  anatomicalZoneId     String?  @map("anatomical_zone_id") @db.Uuid
  requiresContrast     Boolean? @map("requires_contrast")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz

  examType ExamCatalogType @relation(fields: [examTypeId], references: [id])

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([examTypeId])
  @@map("exam_catalog_entries")
  @@schema("tenant_template")
}

