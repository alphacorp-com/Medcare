  unitPrice         Decimal? @map("unit_price") @db.Decimal(12, 2)
  // Dispensing depot: dispensings and vaccinations take from the lots stored here; other
  // depots feed it through transfers. Set for every article (lib/stock/locations).
  storageLocationId String?  @map("storage_location_id") @db.Uuid
  supplierId        String?  @map("supplier_id") @db.Uuid
  isActive          Boolean  @default(true) @map("is_active")
  // Multi-dose vaccines: doses in one stock unit (vial) and how long an opened vial may be
  // used, in hours. 1 / null for everything else.
  dosesPerUnit      Int      @default(1) @map("doses_per_unit")
  openVialHours     Int?     @map("open_vial_hours")
  // RMA3 stock category (tracer, EPI input, antimalarial, oxygen, nutrition) — see lib/stock.
  rma3Category      String?  @map("rma3_category") @db.VarChar(30)
  // RMA3 child treatment this article is (ors / zinc / antibiotic, lib/stock/input): a
  // diagnosis treated with it in the same stay counts in III.7.
  rma3Treatment     String?  @map("rma3_treatment") @db.VarChar(20)
  // Set when the article is a vaccine: vaccinations of this antigen consume its lots.
  vaccineAntigenCode String? @map("vaccine_antigen_code") @db.VarChar(40)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // `stock` is the sum of the lots' quantities, kept in step by lib/stock in the same
  // transaction as every movement; it is never written directly.
  lots      StockLot[]
  movements StockMovement[]
  openVials StockOpenVial[]

  @@index([tenantId])
  @@index([tenantId, vaccineAntigenCode])
  @@map("medication_inventory")
  @@schema("tenant_template")
}

enum StockMovementType {
  opening_balance
  receipt
  dispensing
  vaccination
  expired
  damaged
  lost
  adjustment
  transfer_out
  transfer_in

  @@schema("tenant_template")
}

// One batch of an article (lot number + expiry) in one depot. Exits consume lots
// first-expiry-first-out; a transfer moves quantity to the same lot number in another depot.
model StockLot {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  itemId     String    @map("item_id") @db.Uuid
  locationId String    @map("location_id") @db.Uuid
  lotNumber  String    @map("lot_number") @db.VarChar(60)
  expiryDate DateTime? @map("expiry_date") @db.Date
  quantity   Int       @default(0)
  receivedAt DateTime  @default(now()) @map("received_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  item          MedicationInventory @relation(fields: [itemId], references: [id])
  location      StorageLocation     @relation(fields: [locationId], references: [id])
  movements     StockMovement[]
  immunizations Immunization[]
  openVials     StockOpenVial[]

  @@unique([itemId, lotNumber, locationId])
  @@index([tenantId, expiryDate])
  @@map("stock_lots")
  @@schema("tenant_template")
}

// Append-only stock journal: quantity is signed (+ entry, - exit); balanceAfter is the
// article's total stock right after the movement (gives the stock on any past date).
model StockMovement {
  id           String            @id @default(uuid()) @db.Uuid
  tenantId     String            @map("tenant_id") @db.Uuid
  itemId       String            @map("item_id") @db.Uuid
  lotId        String?           @map("lot_id") @db.Uuid
  locationId   String            @map("location_id") @db.Uuid
  type         StockMovementType
  quantity     Int
  balanceAfter Int               @map("balance_after")
  reason       String?           @db.VarChar(255)
  sourceType   String?           @map("source_type") @db.VarChar(40)
  sourceId     String?           @map("source_id") @db.Uuid
  supplierId   String?           @map("supplier_id") @db.Uuid
  unitCost     Decimal?          @map("unit_cost") @db.Decimal(12, 2)
  occurredAt   DateTime          @default(now()) @map("occurred_at") @db.Timestamptz
  recordedById String            @map("recorded_by_id") @db.Uuid
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz

  item     MedicationInventory @relation(fields: [itemId], references: [id])
  lot      StockLot?           @relation(fields: [lotId], references: [id])
  location StorageLocation     @relation(fields: [locationId], references: [id])

  @@index([tenantId, itemId, occurredAt])
  @@index([tenantId, occurredAt])
  @@index([sourceType, sourceId])
  @@map("stock_movements")
  @@schema("tenant_template")
}

// A multi-dose vial opened for vaccinations: the vial left the stock when it was opened
// (one "vaccination" movement); its doses are then used until it is empty or reaches
// discardAt. Doses left in a vial closed early or expired are the EPI wastage.
model StockOpenVial {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  itemId       String    @map("item_id") @db.Uuid
  lotId        String    @map("lot_id") @db.Uuid
  dosesPerVial Int       @map("doses_per_vial")
  dosesUsed    Int       @default(0) @map("doses_used")
  openedAt     DateTime  @map("opened_at") @db.Timestamptz
  discardAt    DateTime  @map("discard_at") @db.Timestamptz
  closedAt     DateTime? @map("closed_at") @db.Timestamptz
  // emptied | expired | discarded
  closedReason String?   @map("closed_reason") @db.VarChar(20)
  openedById   String    @map("opened_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  item          MedicationInventory @relation(fields: [itemId], references: [id])
  lot           StockLot            @relation(fields: [lotId], references: [id])
  immunizations Immunization[]

  @@index([tenantId, lotId, closedAt])
  @@index([tenantId, openedAt])
  @@map("stock_open_vials")
  @@schema("tenant_template")
}

model Department {
  id        String          @id @default(uuid()) @db.Uuid
  tenantId  String?         @map("tenant_id") @db.Uuid
  code      String          @db.VarChar(20)
  name      String          @db.VarChar(150)
  type      DepartmentType?
  headId    String?         @map("head_id") @db.Uuid
  phone     String?         @db.VarChar(30)
  location  String?         @db.VarChar(120)
  isActive  Boolean         @default(true) @map("is_active")
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz

  users     TenantUser[]
  schedules Schedule[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("departments")
  @@schema("tenant_template")
}

model Role {
  id     String  @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  name   String  @db.VarChar(100)
  // Grants full, unconditional access (bypasses the per-module modules check
  // entirely — see isAdminOrTenantAdmin in lib/permissions.ts). Not tied to
  // any specific role name, so renaming a role never changes its authority;
  // only this flag does. At least one active user with an isSystemAdmin
  // role must always remain (enforced in the roles API, not here).
  isSystemAdmin  Boolean  @default(false) @map("is_system_admin")
  // Marks a role's members as eligible clinical providers (doctors,
  // surgeons, ...) — the durable substitute for matching on the literal
  // role name "doctor". Anything that needs to list "the doctors" (an
  // appointment picker, a prescriber lookup) filters on this flag instead,
  // so it keeps working no matter what the role is named or renamed to.
  isClinicalProvider Boolean @default(false) @map("is_clinical_provider")
  // Default per-module permission set applied when a new user is created
  // with this role — still freely editable per-user afterward, same as
  // today's module checklist.
  defaultModules Json     @default("[]") @map("default_modules")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  users TenantUser[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
  @@schema("tenant_template")
}

model TenantUser {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String?   @map("tenant_id") @db.Uuid
  email          String    @unique @db.VarChar(255)
  fullName       String    @map("full_name") @db.VarChar(255)
  roleId         String    @map("role_id") @db.Uuid
  specialty      String?   @db.VarChar(120)
  rppsNumber     String?   @map("rpps_number") @db.VarChar(20)
  departmentId   String?   @map("department_id") @db.Uuid
  phone          String?   @db.VarChar(30)
  passwordHash   String    @map("password_hash")
  totpSecret     String?   @map("totp_secret")
  isActive       Boolean   @default(true) @map("is_active")
  // Bumped on every password change — the JWT carries the value from sign-in time, so
  // a mismatch on a later request means that session was issued before the password
  // changed and should no longer be trusted (see callbacks.jwt in lib/auth.ts).
  sessionVersion Int       @default(0) @map("session_version")
  modules        Json      @default("[]")
  lastLoginAt    DateTime? @map("last_login_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  role                     Role                      @relation(fields: [roleId], references: [id])
  department               Department?               @relation(fields: [departmentId], references: [id])
  schedules                Schedule[]
  notifications            Notification[]
  conversationParticipants ConversationParticipant[]
  messages                 Message[]

  @@index([roleId])
  @@map("tenant_users")
  @@schema("tenant_template")
}

model Schedule {
  id           String         @id @default(uuid()) @db.Uuid
  tenantId     String?        @map("tenant_id") @db.Uuid
  userId       String         @map("user_id") @db.Uuid
  departmentId String         @map("department_id") @db.Uuid
  shiftType    ShiftType      @map("shift_type")
  date         DateTime       @db.Date
  startTime    DateTime       @map("start_time") @db.Time
  endTime      DateTime       @map("end_time") @db.Time
  status       ScheduleStatus @default(planned)
  replacedBy   String?        @map("replaced_by") @db.Uuid
  notes        String?
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz

  user       TenantUser @relation(fields: [userId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])

  @@unique([userId, date, shiftType])
  @@index([tenantId])
  @@index([userId, date])
  @@index([departmentId, date])
  @@map("schedules")
  @@schema("tenant_template")
}

model FeeSchedule {
  id         String            @id @default(uuid()) @db.Uuid
  tenantId   String?           @map("tenant_id") @db.Uuid
  sourceType BillingSourceType @map("source_type")
  code       String            @db.VarChar(60)
  label      String            @db.VarChar(255)
  unitPrice  Decimal           @map("unit_price") @db.Decimal(12, 2)
  isActive   Boolean           @default(true) @map("is_active")
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([tenantId, sourceType, code])
  @@index([tenantId])
  @@map("fee_schedules")
  @@schema("tenant_template")
}

model PatientInvoice {
  id              String               @id @default(uuid()) @db.Uuid
  tenantId        String?              @map("tenant_id") @db.Uuid
  patientId       String               @map("patient_id") @db.Uuid
  stayId          String?              @map("stay_id") @db.Uuid
  status          BillingInvoiceStatus @default(draft)
  subtotal        Decimal              @default(0) @db.Decimal(14, 2)
  insuranceAmount Decimal              @default(0) @map("insurance_amount") @db.Decimal(14, 2)
  patientAmount   Decimal              @default(0) @map("patient_amount") @db.Decimal(14, 2)
  paidAmount      Decimal              @default(0) @map("paid_amount") @db.Decimal(14, 2)
  currency        String               @default("XAF") @db.VarChar(6)
  issuedById      String?              @map("issued_by_id") @db.Uuid
  notes           String?
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz
  // Third-party payment (lib/coverage): the patient's coverage applied to this invoice, the
  // prior authorization it uses, and the outcome of the computation. insuranceAmount is the
  // payer's share (sum of the lines' payerAmount), exemptionAmount the free-care programmes'
  // share; the patient owes subtotal - insuranceAmount - exemptionAmount + insurerRejectedToPatient.
  coverageId               String?        @map("coverage_id") @db.Uuid
  authorizationId          String?        @map("authorization_id") @db.Uuid
  coverageStatus           CoverageStatus @default(none) @map("coverage_status")
  exemptionAmount          Decimal        @default(0) @map("exemption_amount") @db.Decimal(14, 2)
  // Settled by the payer (claim allocations), and the rejected part charged back to the patient.
  insurerPaidAmount        Decimal        @default(0) @map("insurer_paid_amount") @db.Decimal(14, 2)
  insurerRejectedToPatient Decimal        @default(0) @map("insurer_rejected_to_patient") @db.Decimal(14, 2)

  patient       Patient                @relation(fields: [patientId], references: [id])
  stay          Stay?                  @relation(fields: [stayId], references: [id])
  coverage      PatientCoverage?       @relation(fields: [coverageId], references: [id])
  authorization CoverageAuthorization? @relation(fields: [authorizationId], references: [id])
  lines         PatientInvoiceLine[]
  payments      Payment[]
  claimItems    InsuranceClaimItem[]
  refunds       PatientRefund[]        @relation("RefundSource")
  creditsIn     PatientRefund[]        @relation("RefundTarget")

  @@index([tenantId])
  @@index([patientId])
  @@index([stayId])
  @@index([status])
  @@index([coverageId])
  @@index([authorizationId])
  @@map("patient_invoices")
  @@schema("tenant_template")
}

model PatientInvoiceLine {
  id          String            @id @default(uuid()) @db.Uuid
  tenantId    String?           @map("tenant_id") @db.Uuid
  invoiceId   String            @map("invoice_id") @db.Uuid
  sourceType  BillingSourceType @map("source_type")
  sourceId    String?           @map("source_id") @db.VarChar(160)
  description String            @db.VarChar(255)
  quantity    Decimal           @default(1) @db.Decimal(8, 2)
  unitPrice   Decimal           @map("unit_price") @db.Decimal(12, 2)
  amount      Decimal           @db.Decimal(14, 2)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz
  // Split of `amount` (lib/coverage/compute.ts): free-care programme first, then the payer's
  // rate on the rest; the patient pays the remainder.
  payerAmount        Decimal @default(0) @map("payer_amount") @db.Decimal(14, 2)
  exemptionAmount    Decimal @default(0) @map("exemption_amount") @db.Decimal(14, 2)
  exemptionProgramId String? @map("exemption_program_id") @db.Uuid

  invoice          PatientInvoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  exemptionProgram ExemptionProgram? @relation(fields: [exemptionProgramId], references: [id])

  @@unique([sourceType, sourceId])
  @@index([invoiceId])
  @@map("patient_invoice_lines")
  @@schema("tenant_template")
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  tenantId          String?       @map("tenant_id") @db.Uuid
  invoiceId         String        @map("invoice_id") @db.Uuid
  amount            Decimal       @db.Decimal(14, 2)
  method            PaymentMethod
  status            PaymentStatus @default(pending)
  currency          String        @default("XAF") @db.VarChar(6)
  phoneNumber       String?       @map("phone_number") @db.VarChar(20)
  providerReference String?       @map("provider_reference") @db.VarChar(120)
  rawResponse       Json?         @map("raw_response")
  failureReason     String?       @map("failure_reason")
  initiatedById     String        @map("initiated_by_id") @db.Uuid
  initiatedAt       DateTime      @default(now()) @map("initiated_at") @db.Timestamptz
  completedAt       DateTime?     @map("completed_at") @db.Timestamptz
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  invoice PatientInvoice @relation(fields: [invoiceId], references: [id])

  @@index([tenantId])
  @@index([invoiceId])
  @@index([providerReference])
  @@map("payments")
  @@schema("tenant_template")
}

model AdverseEvent {
  id              String               @id @default(uuid()) @db.Uuid
  tenantId        String?              @map("tenant_id") @db.Uuid
  declaredBy      String               @map("declared_by") @db.Uuid
  patientId       String?              @map("patient_id") @db.Uuid
  stayId          String?              @map("stay_id") @db.Uuid
  type            AdverseEventType
  severity        AdverseEventSeverity
  description     String
  immediateAction String?              @map("immediate_action")
  status          AdverseEventStatus   @default(reported)
  rcaAnalysis     Json                 @default("{}") @map("rca_analysis")
  actionPlan      Json                 @default("[]") @map("action_plan")
  closedAt        DateTime?            @map("closed_at") @db.Timestamptz
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  patient Patient? @relation(fields: [patientId], references: [id])
  stay    Stay?    @relation(fields: [stayId], references: [id])

  @@index([tenantId])
  @@map("adverse_events")
  @@schema("tenant_template")
}

// =============================================================================
// 5. TENANT SCHEMA — Notifications & Conversations
// =============================================================================

enum NotificationType {
  module_event
  message
  system

  @@schema("tenant_template")
}

model Notification {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String?          @map("tenant_id") @db.Uuid
  recipientId  String           @map("recipient_id") @db.Uuid
  type         NotificationType @default(module_event)
  moduleId     String?          @map("module_id") @db.VarChar(60)
  title        String           @db.VarChar(200)
  body         String?
  link         String?          @db.VarChar(300)
  resourceType String?          @map("resource_type") @db.VarChar(80)
  resourceId   String?          @map("resource_id") @db.Uuid
  actorId      String?          @map("actor_id") @db.Uuid
  isRead       Boolean          @default(false) @map("is_read")
  readAt       DateTime?        @map("read_at") @db.Timestamptz
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz

  recipient TenantUser @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, isRead])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("notifications")
  @@schema("tenant_template")
}

model Conversation {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String?   @map("tenant_id") @db.Uuid
  title         String?   @db.VarChar(150)
  isGroup       Boolean   @default(false) @map("is_group")
  createdBy     String    @map("created_by") @db.Uuid
  lastMessageAt DateTime? @map("last_message_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  participants ConversationParticipant[]
  messages     Message[]

  @@index([tenantId])
  @@map("conversations")
  @@schema("tenant_template")
}

model ConversationParticipant {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  lastReadAt     DateTime? @map("last_read_at") @db.Timestamptz
  joinedAt       DateTime  @default(now()) @map("joined_at") @db.Timestamptz

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         TenantUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
  @@schema("tenant_template")
}

model Message {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  senderId       String   @map("sender_id") @db.Uuid
  body           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       TenantUser   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
  @@schema("tenant_template")
}

// =============================================================================
// 6. TENANT SCHEMA — Configurable Reference Data
// =============================================================================

enum ReferenceCatalogType {
  admission_type
  appointment_type
  room_type
  insurance_type
  pharmaceutical_unit
  imaging_type
  anatomical_zone
  vaccine_antigen

  @@schema("tenant_template")
}

// Generic tenant-configurable "type" catalog shared by the 7 simple reference lists
// above (admission/appointment/room/insurance types, pharmaceutical units, imaging
// types, anatomical zones) — same code/name-fr/name-en/active/order shape for all of
// them, avoiding 7 near-identical models + route sets + settings pages.
model ReferenceCatalogItem {
  // Payers of this insurance type (catalogType insurance_type only).
  payers Payer[]

  id          String               @id @default(uuid()) @db.Uuid
  tenantId    String?              @map("tenant_id") @db.Uuid
  catalogType ReferenceCatalogType @map("catalog_type")
  code        String               @db.VarChar(40)
  nameFr      String               @map("name_fr") @db.VarChar(150)
  nameEn      String?              @map("name_en") @db.VarChar(150)
  color       String?              @db.VarChar(20)
  icon        String?              @db.VarChar(40)
  group       String?              @db.VarChar(80)
  order       Int                  @default(0)
  isActive    Boolean              @default(true) @map("is_active")
  metadata    Json                 @default("{}")
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([tenantId, catalogType, code])
  @@index([tenantId, catalogType])
  @@map("reference_catalog_items")
  @@schema("tenant_template")
}

model MedicalActCategory {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String?  @map("tenant_id") @db.Uuid
  code      String   @db.VarChar(40)
  nameFr    String   @map("name_fr") @db.VarChar(150)
  nameEn    String?  @map("name_en") @db.VarChar(150)
  color     String?  @db.VarChar(20)
  order     Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  // RMA3 VI.3 income rubric of the acts of this category (lib/reports/rma3-income.ts).
  rma3IncomeRubric String? @map("rma3_income_rubric") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  acts MedicalAct[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("medical_act_categories")
  @@schema("tenant_template")
}

model MedicalAct {
  id                        String   @id @default(uuid()) @db.Uuid
  tenantId                  String?  @map("tenant_id") @db.Uuid
  categoryId                String   @map("category_id") @db.Uuid
  code                      String   @db.VarChar(40)
  nameFr                    String   @map("name_fr") @db.VarChar(200)
  nameEn                    String?  @map("name_en") @db.VarChar(200)
  basePrice                 Decimal  @map("base_price") @db.Decimal(12, 2)
  unit                      String?  @db.VarChar(50)
  // Nomenclature coverage rate of the act (0-100 %, null = none): replaces the family rate for
  // the conventions that apply the nomenclature (CoverageAgreement.useNomenclatureRates).
  defaultPecCoveragePercent Int?     @map("default_pec_coverage_percent")
