  @@index([tenantId, screenedAt])
  @@map("tb_screenings")
  @@schema("tenant_template")
}

enum ChronicCondition {
  diabetes
  hypertension

  @@schema("tenant_template")
}

enum ChronicExitReason {
  lost_to_follow_up
  transferred
  died
  other

  @@schema("tenant_template")
}

// Chronic disease programme (RMA3 IV.4.1, IV.4.4): enrolment and follow-up visits.
model ChronicCareEnrolment {
  id           String             @id @default(uuid()) @db.Uuid
  tenantId     String             @map("tenant_id") @db.Uuid
  patientId    String             @map("patient_id") @db.Uuid
  condition    ChronicCondition
  enrolledAt   DateTime           @map("enrolled_at") @db.Timestamptz
  exitedAt     DateTime?          @map("exited_at") @db.Timestamptz
  exitReason   ChronicExitReason? @map("exit_reason")
  notes        String?
  recordedById String             @map("recorded_by_id") @db.Uuid
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz

  patient Patient            @relation(fields: [patientId], references: [id])
  visits  ChronicCareVisit[]

  @@index([tenantId, condition])
  @@map("chronic_care_enrolments")
  @@schema("tenant_template")
}

model ChronicCareVisit {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  enrolmentId         String   @map("enrolment_id") @db.Uuid
  visitDate           DateTime @map("visit_date") @db.Timestamptz
  onTreatment         Boolean  @default(false) @map("on_treatment")
  systolic            Int?
  diastolic           Int?
  hba1c               Decimal? @db.Decimal(4, 1)
  educationIndividual Boolean  @default(false) @map("education_individual")
  educationGroup      Boolean  @default(false) @map("education_group")
  recordedById        String   @map("recorded_by_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz

  enrolment ChronicCareEnrolment @relation(fields: [enrolmentId], references: [id])

  @@index([tenantId, visitDate])
  @@map("chronic_care_visits")
  @@schema("tenant_template")
}

enum CivilEventType {
  birth
  death

  @@schema("tenant_template")
}

// Birth / death declarations transmitted to the civil registry (RMA3 V.2).
model CivilRegistrationDeclaration {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  type          CivilEventType
  patientId     String?        @map("patient_id") @db.Uuid
  personName    String         @map("person_name") @db.VarChar(150)
  eventDate     DateTime       @map("event_date") @db.Date
  transmittedAt DateTime       @map("transmitted_at") @db.Date
  reference     String?        @db.VarChar(80)
  recordedById  String         @map("recorded_by_id") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId, transmittedAt])
  @@map("civil_registration_declarations")
  @@schema("tenant_template")
}

// Adverse drug reaction (pharmacovigilance, RMA3 V.8).
model DrugAdverseReaction {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  patientId      String    @map("patient_id") @db.Uuid
  inventoryId    String?   @map("inventory_id") @db.Uuid
  drugName       String    @map("drug_name") @db.VarChar(255)
  lotNumber      String?   @map("lot_number") @db.VarChar(60)
  expiryDate     DateTime? @map("expiry_date") @db.Date
  reactionAt     DateTime  @map("reaction_at") @db.Timestamptz
  description    String
  serious        Boolean   @default(false)
  investigatedAt DateTime? @map("investigated_at") @db.Timestamptz
  outcome        String?   @db.VarChar(200)
  recordedById   String    @map("recorded_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([tenantId, createdAt])
  @@map("drug_adverse_reactions")
  @@schema("tenant_template")
}

// ─────────────────────────────────────────────────────────────────────────────
// Third-party payment ("prises en charge") — lib/coverage
// ─────────────────────────────────────────────────────────────────────────────

// Family of an invoice line, the level at which a convention sets its rates.
enum CoverageFamily {
  consultation
  laboratory
  imaging
  pharmacy
  hospitalization
  surgery
  maternity
  other

  @@schema("tenant_template")
}

// Outcome of the coverage computation of an invoice.
enum CoverageStatus {
  none                   // no coverage on the invoice
  applied                // the payer's share is applied
  capped                 // applied, limited by a ceiling or the authorization amount
  authorization_required // the convention requires a prior authorization: no payer share
  invalid_coverage       // coverage expired / suspended / convention inactive: no payer share
  age_limit_exceeded     // child dependant older than the convention allows: no payer share
  frozen                 // claimed to the payer: shares kept as claimed

  @@schema("tenant_template")
}

enum CoverageAuthorizationStatus {
  active
  cancelled

  @@schema("tenant_template")
}

enum ExemptionEligibility {
  automatic // age / sex / pregnancy criteria
  enrolment // patients enrolled one by one (indigents…)

  @@schema("tenant_template")
}

enum InsuranceClaimStatus {
  draft
  submitted
  partially_settled
  settled
  closed

  @@schema("tenant_template")
}

enum PayerPaymentMethod {
  bank_transfer
  cheque
  cash
  mobile_money
  other

  @@schema("tenant_template")
}

// Organisation that pays for its members (CNPS, insurer, mutual, employer…).
model Payer {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  code            String   @db.VarChar(40)
  name            String   @db.VarChar(150)
  insuranceTypeId String?  @map("insurance_type_id") @db.Uuid
  contactName     String?  @map("contact_name") @db.VarChar(150)
  phone           String?  @db.VarChar(30)
  email           String?  @db.VarChar(150)
  address         String?  @db.VarChar(255)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  insuranceType ReferenceCatalogItem? @relation(fields: [insuranceTypeId], references: [id])
  agreements    CoverageAgreement[]
  claims        InsuranceClaim[]
  payments      PayerPayment[]

  @@unique([tenantId, code])
  @@map("payers")
  @@schema("tenant_template")
}

// Convention signed with a payer: rates per family, ceilings, authorization rule.
model CoverageAgreement {
  id                     String    @id @default(uuid()) @db.Uuid
  tenantId               String    @map("tenant_id") @db.Uuid
  payerId                String    @map("payer_id") @db.Uuid
  code                   String    @db.VarChar(40)
  name                   String    @db.VarChar(150)
  // Rate (0-100 %) for the families without a specific rate.
  defaultRate            Int       @map("default_rate")
  // Payer share ceilings (FCFA), null = none: per invoice, per beneficiary and calendar year,
  // and per membership (holder + dependants) and calendar year.
  perInvoiceCeiling      Decimal?  @map("per_invoice_ceiling") @db.Decimal(14, 2)
  annualCeiling          Decimal?  @map("annual_ceiling") @db.Decimal(14, 2)
  familyAnnualCeiling    Decimal?  @map("family_annual_ceiling") @db.Decimal(14, 2)
  // Children dependants are covered until this age (years, excluded), null = no limit.
  childMaxAgeYears       Int?      @map("child_max_age_years")
  // Apply the acts' nomenclature rates (MedicalAct.defaultPecCoveragePercent) before the family rates.
  useNomenclatureRates   Boolean   @default(false) @map("use_nomenclature_rates")
  // Prior authorization: required when the payer share exceeds the threshold (null = always).
  requiresAuthorization  Boolean   @default(false) @map("requires_authorization")
  authorizationThreshold Decimal?  @map("authorization_threshold") @db.Decimal(14, 2)
  validFrom              DateTime? @map("valid_from") @db.Date
  validTo                DateTime? @map("valid_to") @db.Date
  isActive               Boolean   @default(true) @map("is_active")
  notes                  String?
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  payer    Payer                   @relation(fields: [payerId], references: [id])
  rates    CoverageAgreementRate[]
  policies CoveragePolicy[]

  @@unique([tenantId, code])
  @@index([payerId])
  @@map("coverage_agreements")
  @@schema("tenant_template")
}

model CoverageAgreementRate {
  id          String         @id @default(uuid()) @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  agreementId String         @map("agreement_id") @db.Uuid
  family      CoverageFamily
  rate        Int

  agreement CoverageAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  @@unique([agreementId, family])
  @@map("coverage_agreement_rates")
  @@schema("tenant_template")
}

// Membership ("adhésion") to a convention: a member number held by a person — a patient of the
// facility or not — and covering beneficiaries (the holder, spouse, children…).
model CoveragePolicy {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  agreementId     String    @map("agreement_id") @db.Uuid
  memberNumber    String    @map("member_number") @db.VarChar(60)
  holderName      String    @map("holder_name") @db.VarChar(150)
  // The holder when they are a patient of the facility.
  holderPatientId String?   @map("holder_patient_id") @db.Uuid
  employer        String?   @db.VarChar(150)
  validFrom       DateTime  @map("valid_from") @db.Date
  validTo         DateTime? @map("valid_to") @db.Date
  // Ended or suspended before validTo: every beneficiary loses the coverage.
  endedAt         DateTime? @map("ended_at") @db.Timestamptz
  notes           String?
  createdById     String    @map("created_by_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  agreement     CoverageAgreement @relation(fields: [agreementId], references: [id])
  holderPatient Patient?          @relation(fields: [holderPatientId], references: [id])
  beneficiaries PatientCoverage[]

  @@unique([agreementId, memberNumber])
  @@index([tenantId])
  @@map("coverage_policies")
  @@schema("tenant_template")
}

enum CoverageRelationship {
  holder
  spouse
  child
  other

  @@schema("tenant_template")
}

// A patient covered by a membership, as its holder or a dependant.
model PatientCoverage {
  id                String               @id @default(uuid()) @db.Uuid
  tenantId          String               @map("tenant_id") @db.Uuid
  patientId         String               @map("patient_id") @db.Uuid
  policyId          String               @map("policy_id") @db.Uuid
  relationship      CoverageRelationship @default(holder)
  // Number of the beneficiary on the membership card (some payers number each dependant).
  beneficiaryNumber String?              @map("beneficiary_number") @db.VarChar(60)
  // Within the membership's validity (a dependant added later, removed earlier).
  validFrom         DateTime             @map("valid_from") @db.Date
  validTo           DateTime?            @map("valid_to") @db.Date
  // Removed from the membership before validTo.
  endedAt           DateTime?            @map("ended_at") @db.Timestamptz
  notes             String?
  createdById       String               @map("created_by_id") @db.Uuid
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  patient        Patient                 @relation(fields: [patientId], references: [id])
  policy         CoveragePolicy          @relation(fields: [policyId], references: [id])
  authorizations CoverageAuthorization[]
  invoices       PatientInvoice[]

  @@unique([policyId, patientId])
  @@index([tenantId, patientId])
  @@map("patient_coverages")
  @@schema("tenant_template")
}

// Prior authorization ("bon de prise en charge") issued by the payer.
model CoverageAuthorization {
  id               String                      @id @default(uuid()) @db.Uuid
  tenantId         String                      @map("tenant_id") @db.Uuid
  coverageId       String                      @map("coverage_id") @db.Uuid
  number           String                      @db.VarChar(60)
  // Maximum payer share it allows (FCFA), null = no amount limit.
  authorizedAmount Decimal?                    @map("authorized_amount") @db.Decimal(14, 2)
  validFrom        DateTime                    @map("valid_from") @db.Date
  validTo          DateTime                    @map("valid_to") @db.Date
  // Restricted to one stay when set.
  stayId           String?                     @map("stay_id") @db.Uuid
  status           CoverageAuthorizationStatus @default(active)
  notes            String?
  createdById      String                      @map("created_by_id") @db.Uuid
  createdAt        DateTime                    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime                    @updatedAt @map("updated_at") @db.Timestamptz

  coverage PatientCoverage  @relation(fields: [coverageId], references: [id])
  invoices PatientInvoice[]

  @@unique([coverageId, number])
  @@index([tenantId])
  @@map("coverage_authorizations")
  @@schema("tenant_template")
}

// Free-care programme (malaria under 5, PMTCT, TB, indigents…), applied before the payer.
model ExemptionProgram {
  id               String               @id @default(uuid()) @db.Uuid
  tenantId         String               @map("tenant_id") @db.Uuid
  code             String               @db.VarChar(40)
  name             String               @db.VarChar(150)
  // Share of the line it pays (1-100 %).
  rate             Int
  families         CoverageFamily[]
  // Optional restriction to these exam / medical act codes and pharmacy articles; empty = any
  // line of the families.
  actCodes         String[]             @map("act_codes")
  inventoryItemIds String[]             @map("inventory_item_ids")
  eligibility      ExemptionEligibility
  // Automatic criteria: age in months [min, max), sex, ongoing pregnancy.
  minAgeMonths     Int?                 @map("min_age_months")
  maxAgeMonths     Int?                 @map("max_age_months")
  sex              Gender?
  pregnantOnly     Boolean              @default(false) @map("pregnant_only")
  validFrom        DateTime?            @map("valid_from") @db.Date
  validTo          DateTime?            @map("valid_to") @db.Date
  isActive         Boolean              @default(true) @map("is_active")
  notes            String?
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  enrolments PatientExemption[]
  lines      PatientInvoiceLine[]

  @@unique([tenantId, code])
  @@map("exemption_programs")
  @@schema("tenant_template")
}

// A patient enrolled in an "enrolment" programme.
model PatientExemption {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  patientId   String    @map("patient_id") @db.Uuid
  programId   String    @map("program_id") @db.Uuid
  validFrom   DateTime  @map("valid_from") @db.Date
  validTo     DateTime? @map("valid_to") @db.Date
  reason      String
  grantedById String    @map("granted_by_id") @db.Uuid
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz
  revokedById String?   @map("revoked_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  patient Patient          @relation(fields: [patientId], references: [id])
  program ExemptionProgram @relation(fields: [programId], references: [id])

  @@index([tenantId, patientId])
  @@map("patient_exemptions")
  @@schema("tenant_template")
}

// Claim batch ("bordereau") sent to a payer for a period.
model InsuranceClaim {
  id            String               @id @default(uuid()) @db.Uuid
  tenantId      String               @map("tenant_id") @db.Uuid
  payerId       String               @map("payer_id") @db.Uuid
  number        String               @db.VarChar(40)
  periodStart   DateTime             @map("period_start") @db.Date
  periodEnd     DateTime             @map("period_end") @db.Date
  status        InsuranceClaimStatus @default(draft)
  submittedAt   DateTime?            @map("submitted_at") @db.Timestamptz
  closedAt      DateTime?            @map("closed_at") @db.Timestamptz
  notes         String?
  createdById   String               @map("created_by_id") @db.Uuid
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  payer    Payer                @relation(fields: [payerId], references: [id])
  items    InsuranceClaimItem[]
  payments PayerPayment[]

  @@unique([tenantId, number])
  @@index([payerId])
  @@map("insurance_claims")
  @@schema("tenant_template")
}

// One invoice in a claim: amount claimed, settled and rejected.
model InsuranceClaimItem {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  claimId         String   @map("claim_id") @db.Uuid
  invoiceId       String   @map("invoice_id") @db.Uuid
  claimedAmount   Decimal  @map("claimed_amount") @db.Decimal(14, 2)
  paidAmount      Decimal  @default(0) @map("paid_amount") @db.Decimal(14, 2)
  // Sum of the active rejections (InsuranceClaimRejection), kept by lib/coverage/claims.ts.
  rejectedAmount  Decimal  @default(0) @map("rejected_amount") @db.Decimal(14, 2)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  claim       InsuranceClaim           @relation(fields: [claimId], references: [id], onDelete: Cascade)
  invoice     PatientInvoice           @relation(fields: [invoiceId], references: [id])
  allocations PayerPaymentAllocation[]
  rejections  InsuranceClaimRejection[]

  // An invoice is claimed once: a rejected part is reversed or settled on the same item.
  @@unique([invoiceId])
  @@map("insurance_claim_items")
  @@schema("tenant_template")
}

// Money received from a payer, allocated to claim items.
model PayerPayment {
  id          String             @id @default(uuid()) @db.Uuid
  tenantId    String             @map("tenant_id") @db.Uuid
  payerId     String             @map("payer_id") @db.Uuid
  claimId     String?            @map("claim_id") @db.Uuid
  amount      Decimal            @db.Decimal(14, 2)
  receivedAt  DateTime           @map("received_at") @db.Timestamptz
  method      PayerPaymentMethod
  reference   String?            @db.VarChar(120)
  notes       String?
  recordedById String            @map("recorded_by_id") @db.Uuid
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz
  // Recorded by mistake: cancelled once nothing is allocated any more (excluded everywhere).
  status       PayerPaymentStatus @default(recorded)
  cancelledAt  DateTime?          @map("cancelled_at") @db.Timestamptz
  cancelReason String?            @map("cancel_reason") @db.VarChar(500)

  payer       Payer                    @relation(fields: [payerId], references: [id])
  claim       InsuranceClaim?          @relation(fields: [claimId], references: [id])
  allocations PayerPaymentAllocation[]
  refunds     PayerPaymentRefund[]

  @@index([tenantId, receivedAt])
  @@map("payer_payments")
  @@schema("tenant_template")
}

model PayerPaymentAllocation {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  paymentId   String   @map("payment_id") @db.Uuid
  claimItemId String   @map("claim_item_id") @db.Uuid
  amount      Decimal  @db.Decimal(14, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  // Allocated by mistake: reversed (the amount goes back to the payment's unallocated balance).
  reversedAt   DateTime? @map("reversed_at") @db.Timestamptz
  reversedById String?   @map("reversed_by_id") @db.Uuid

  payment   PayerPayment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  claimItem InsuranceClaimItem @relation(fields: [claimItemId], references: [id])

  @@index([claimItemId])
  @@map("payer_payment_allocations")
  @@schema("tenant_template")
}

enum PayerPaymentStatus {
  recorded
  cancelled

  @@schema("tenant_template")
}

// The payer refuses (part of) a claim item. Reversible while the claim is not closed.
model InsuranceClaimRejection {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  claimItemId      String    @map("claim_item_id") @db.Uuid
  amount           Decimal   @db.Decimal(14, 2)
  reason           String    @db.VarChar(500)
  // Charged back to the patient (added to what they owe), else written off by the facility.
  chargedToPatient Boolean   @default(false) @map("charged_to_patient")
  recordedById     String    @map("recorded_by_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  reversedAt       DateTime? @map("reversed_at") @db.Timestamptz
  reversedById     String?   @map("reversed_by_id") @db.Uuid
  reversalReason   String?   @map("reversal_reason") @db.VarChar(500)

  claimItem InsuranceClaimItem @relation(fields: [claimItemId], references: [id], onDelete: Cascade)

  @@index([claimItemId])
  @@map("insurance_claim_rejections")
  @@schema("tenant_template")
}

// Part of a payer payment given back to the payer (overpayment, duplicate transfer…).
model PayerPaymentRefund {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  paymentId    String   @map("payment_id") @db.Uuid
  amount       Decimal  @db.Decimal(14, 2)
  refundedAt   DateTime @map("refunded_at") @db.Timestamptz
  reference    String?  @db.VarChar(120)
  reason       String   @db.VarChar(500)
  recordedById String   @map("recorded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  payment PayerPayment @relation(fields: [paymentId], references: [id])

  @@index([tenantId, refundedAt])
  @@map("payer_payment_refunds")
  @@schema("tenant_template")
}

enum PatientRefundKind {
  refund   // money given back to the patient
  transfer // moved to another open invoice of the same patient

  @@schema("tenant_template")
}

// What a patient paid beyond their share on an invoice, given back or moved to another invoice.
model PatientRefund {
  id              String            @id @default(uuid()) @db.Uuid
  tenantId        String            @map("tenant_id") @db.Uuid
  invoiceId       String            @map("invoice_id") @db.Uuid
  kind            PatientRefundKind
  amount          Decimal           @db.Decimal(14, 2)
  // Refund: how the money was given back.
  method          PaymentMethod?
  reference       String?           @db.VarChar(120)
  // Transfer: the invoice credited, and the payment created on it.
  targetInvoiceId String?           @map("target_invoice_id") @db.Uuid
  targetPaymentId String?           @unique @map("target_payment_id") @db.Uuid
  reason          String            @db.VarChar(500)
  refundedAt      DateTime          @map("refunded_at") @db.Timestamptz
  recordedById    String            @map("recorded_by_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz

  invoice       PatientInvoice  @relation("RefundSource", fields: [invoiceId], references: [id])
  targetInvoice PatientInvoice? @relation("RefundTarget", fields: [targetInvoiceId], references: [id])

  @@index([tenantId, refundedAt])
  @@index([invoiceId])
  @@map("patient_refunds")
  @@schema("tenant_template")
}
