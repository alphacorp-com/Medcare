  enrolledAt       DateTime            @map("enrolled_at") @db.Date
  entryPoint       ScreeningEntryPoint @map("entry_point")
  transferIn       TransferScope?      @map("transfer_in")
  pregnancyId      String?             @map("pregnancy_id") @db.Uuid
  status           HivCareStatus       @default(active)
