generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema", "views", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  schemas    = ["public", "tenant_template"]
  extensions = [uuidOssp(map: "uuid-ossp")]
}

// =============================================================================
// 2. ENUMS
// =============================================================================

enum TenantStatus {
  trial
  active
  suspended
  churned

  @@schema("public")
}

enum TenantType {
  hospital
  clinic
  ehpad
  lab
  specialized

  @@schema("public")
}

enum SubscriptionStatus {
  trial
  active
  past_due
  cancelled

  @@schema("public")
}

enum BillingCycle {
  monthly
  annual
  perpetual

  @@schema("public")
}

enum PlanTier {
  core
  clinical
  advanced
  enterprise

  @@schema("public")
}

enum ModuleCategory {
  clinical
  admin
  finance
  analytics
  integration
  hr

  @@schema("public")
}

enum ModuleStatus {
  active
  suspended
  trial
  pending

  @@schema("public")
}

enum InvoiceStatus {
  draft
  open
  paid
  void
  uncollectible

  @@schema("public")
}

enum OneTimeChargeType {
  implementation
  training
  integration
  migration
  custom
  support

  @@schema("public")
}

enum OneTimeChargeStatus {
  pending
  invoiced
  paid
  cancelled

  @@schema("public")
}

enum AdminRole {
  superadmin
  sales
  support
  devops
  finance

  @@schema("public")
}

enum AuditActorType {
  admin
  tenant_user
  system
  api

  @@schema("public")
}

enum LicenseKeyStatus {
  generated
  redeemed
  revoked
  expired

  @@schema("public")
}

// Tenant-side enums
enum Gender {
  M
  F
  U

  @@schema("tenant_template")
}

enum StayType {
  emergency
  scheduled
  day_care
  outpatient

  @@schema("tenant_template")
}

enum StayStatus {
  pre_admission
  in_progress
  discharged
  transferred
  deceased

  @@schema("tenant_template")
}

// Declaration order is significant: it drives the ascending sort used by the
// triage queue (`ORDER BY triage_acuity ASC`), most critical first.
enum TriageAcuity {
  resuscitation
  emergent
  urgent
  less_urgent
  non_urgent

  @@schema("tenant_template")
}

// Tracks a Stay's progress through the doctor's consultation queue, independent of
// StayStatus (which stays "in_progress" the whole time) — so adding this never changes
// what any existing `status: "in_progress"` filter across admissions/KPIs/dashboard sees.
enum ConsultationStatus {
  waiting
  claimed
  completed

  @@schema("tenant_template")
}

enum AppointmentStatus {
  booked
  confirmed
  checked_in
  completed
  no_show
  cancelled

  @@schema("tenant_template")
}

enum MedicalRecordType {
  consultation
  observation
  surgery_report
  discharge_letter
  referral
  nursing_note
  anesthesia
  antenatal_note
  delivery_report

  @@schema("tenant_template")
}

enum PrescriptionStatus {
  pending
  validated
  dispensed
  cancelled
  expired

  @@schema("tenant_template")
}

enum ExamType {
  biology
  radiology
  pathology
  cardiology
  other

  @@schema("tenant_template")
}

enum ExamUrgency {
  stat
  urgent
  routine

  @@schema("tenant_template")
}

enum ExamRequestStatus {
  requested
  scheduled
  in_progress
  completed
  cancelled

  @@schema("tenant_template")
}

enum SurgicalStatus {
  scheduled
  in_progress
  completed
  cancelled
  postponed

  @@schema("tenant_template")
}

enum DispensingStatus {
  dispensed
  administered
  refused
  wasted

  @@schema("tenant_template")
}

enum ShiftType {
  morning
  afternoon
  night
  on_call
  off

  @@schema("tenant_template")
}

enum ScheduleStatus {
  planned
  confirmed
  modified
  absent
  replaced

  @@schema("tenant_template")
}

enum BillingSourceType {
  consultation
  exam
  surgery
  pharmacy_dispensation
  antenatal_visit
  delivery
  other

  @@schema("tenant_template")
}

enum BillingInvoiceStatus {
  draft
  pending_payment
  partially_paid
  paid
  cancelled

  @@schema("tenant_template")
}

enum PaymentMethod {
  cash
  card
  insurance
  mobile_money_orange
  mobile_money_mtn
  bank_transfer

  @@schema("tenant_template")
}

enum PaymentStatus {
  pending
  successful
  failed
  cancelled

  @@schema("tenant_template")
}

enum AdverseEventType {
  medication_error
  fall
  infection
  procedure_complication
  equipment_failure
  diagnostic_error
  other

  @@schema("tenant_template")
}

enum AdverseEventSeverity {
  minor
  moderate
  major
  catastrophic

  @@schema("tenant_template")
}

enum AdverseEventStatus {
  reported
  under_analysis
  action_plan
  closed

  @@schema("tenant_template")
}

enum TenantUserRole {
  tenant_admin
  doctor
  nurse
  pharmacist
  lab_tech
  radiologist
  billing
  hr
  viewer

  @@schema("tenant_template")
}

enum DepartmentType {
  emergency
  surgery
  icu
  medicine
  pediatrics
  radiology
  laboratory
  pharmacy
  maternity
  admin
  other

  @@schema("tenant_template")
}

enum PregnancyStatus {
  ongoing
  delivered
  miscarried
  terminated

  @@schema("tenant_template")
}

enum DeliveryMode {
  vaginal
  assisted_vaginal
  cesarean

  @@schema("tenant_template")
}

// =============================================================================
// 3. PUBLIC SCHEMA — Plateforme
// =============================================================================

model Tenant {
  id           String       @id @default(uuid()) @db.Uuid
  slug         String       @unique @db.VarChar(60)
  name         String       @db.VarChar(255)
  type         TenantType
  countryCode  String       @default("CM") @map("country_code") @db.Char(2)
  timezone     String       @default("Africa/Douala") @db.VarChar(50)
  locale       String       @default("fr") @db.VarChar(10)
  dbSchema     String       @unique @map("db_schema") @db.VarChar(80)
  status       TenantStatus @default(trial)
  contactEmail String?      @map("contact_email") @db.VarChar(255)
  contactPhone String?      @map("contact_phone") @db.VarChar(30)
  address      String?
  logoUrl      String?      @map("logo_url")
  metadata     Json         @default("{}")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  suspendedAt  DateTime?    @map("suspended_at") @db.Timestamptz
  churnedAt    DateTime?    @map("churned_at") @db.Timestamptz

  // Relations
  settings           TenantSetting[]
  subscriptions      Subscription[]
  invoices           Invoice[]
  oneTimeCharges     OneTimeCharge[]
  tenantModules      TenantModule[]
  tenantFeatureFlags TenantFeatureFlag[]
  licenseKeys        LicenseKey[]
  auditLogs          AuditLog[]

  @@index([slug])
  @@index([status])
  @@index([dbSchema])
  @@map("tenants")
  @@schema("public")
}

model TenantSetting {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String   @db.VarChar(120)
  value     Json
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@map("tenant_settings")
  @@schema("public")
}

model Plan {
  id           String       @id @default(uuid()) @db.Uuid
  name         String       @db.VarChar(100)
  tier         PlanTier
  billingCycle BillingCycle @map("billing_cycle")
  basePrice    Decimal      @default(0) @map("base_price") @db.Decimal(12, 2)
  pricePerBed  Decimal?     @map("price_per_bed") @db.Decimal(8, 2)
  pricePerUser Decimal?     @map("price_per_user") @db.Decimal(8, 2)
  maxUsers     Int?         @map("max_users")
  maxBeds      Int?         @map("max_beds")
  maxStorageGb Int?         @map("max_storage_gb")
  currency     String       @default("XAF") @db.Char(3)
  features     Json         @default("{}")
  isActive     Boolean      @default(true) @map("is_active")
  isPublic     Boolean      @default(true) @map("is_public")
  sortOrder    Int          @default(0) @map("sort_order") @db.SmallInt
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  subscriptions Subscription[]
  planModules   PlanModule[]
  licenseKeys   LicenseKey[]

  @@map("plans")
  @@schema("public")
}

model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  tenantId           String             @map("tenant_id") @db.Uuid
  planId             String             @map("plan_id") @db.Uuid
  status             SubscriptionStatus @default(trial)
  trialEndsAt        DateTime?          @map("trial_ends_at") @db.Timestamptz
  currentPeriodStart DateTime           @default(now()) @map("current_period_start") @db.Timestamptz
  currentPeriodEnd   DateTime           @map("current_period_end") @db.Timestamptz
  cancelledAt        DateTime?          @map("cancelled_at") @db.Timestamptz
  cancelReason       String?            @map("cancel_reason")
  seatsCount         Int                @default(5) @map("seats_count")
  bedsCount          Int                @default(0) @map("beds_count")
  mrr                Decimal            @default(0) @map("mrr") @db.Decimal(12, 2)
  currency           String             @default("XAF") @db.Char(3)
  paymentMethod      String?            @map("payment_method") @db.VarChar(40)
  externalSubId      String?            @map("external_sub_id") @db.VarChar(120)
  notes              String?
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  plan        Plan         @relation(fields: [planId], references: [id])
  invoices    Invoice[]
  licenseKeys LicenseKey[]

  @@index([tenantId])
  @@index([status])
  @@index([currentPeriodEnd])
  @@map("subscriptions")
  @@schema("public")
}

model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  subscriptionId String        @map("subscription_id") @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  invoiceNumber  String        @unique @map("invoice_number") @db.VarChar(40)
  amountHt       Decimal       @map("amount_ht") @db.Decimal(12, 2)
  taxRate        Decimal       @default(0) @map("tax_rate") @db.Decimal(5, 2)
  currency       String        @default("XAF") @db.Char(3)
  status         InvoiceStatus @default(draft)
  dueDate        DateTime      @map("due_date") @db.Date
  paidAt         DateTime?     @map("paid_at") @db.Timestamptz
  invoicePdfUrl  String?       @map("invoice_pdf_url")
  lineItems      Json          @default("[]") @map("line_items")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz

  subscription   Subscription    @relation(fields: [subscriptionId], references: [id])
  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  oneTimeCharges OneTimeCharge[]

  @@index([tenantId])
  @@index([status])
  @@map("invoices")
  @@schema("public")
}

model OneTimeCharge {
  id          String              @id @default(uuid()) @db.Uuid
  tenantId    String              @map("tenant_id") @db.Uuid
  type        OneTimeChargeType
  description String
  amount      Decimal             @db.Decimal(12, 2)
  currency    String              @default("XAF") @db.Char(3)
  status      OneTimeChargeStatus @default(pending)
  invoiceId   String?             @map("invoice_id") @db.Uuid
  createdBy   String?             @map("created_by") @db.Uuid
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  invoice Invoice? @relation(fields: [invoiceId], references: [id])

  @@map("one_time_charges")
  @@schema("public")
}

model Module {
  id           String         @id @default(uuid()) @db.Uuid
  code         String         @unique @db.VarChar(60)
  name         String         @db.VarChar(150)
  tier         PlanTier
  category     ModuleCategory
  version      String         @default("1.0.0") @db.VarChar(20)
  description  String?
  changelog    Json           @default("[]")
  priceMonthly Decimal?       @map("price_monthly") @db.Decimal(10, 2)
  priceAnnual  Decimal?       @map("price_annual") @db.Decimal(10, 2)
  dependencies Json           @default("[]")
  configSchema Json           @default("{}") @map("config_schema")
  isPublished  Boolean        @default(false) @map("is_published")
  isBeta       Boolean        @default(false) @map("is_beta")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  planModules   PlanModule[]
  tenantModules TenantModule[]
  featureFlags  FeatureFlag[]

  @@index([code])
  @@index([tier])
  @@map("modules")
  @@schema("public")
}

model PlanModule {
  id         String  @id @default(uuid()) @db.Uuid
  planId     String  @map("plan_id") @db.Uuid
  moduleId   String  @map("module_id") @db.Uuid
  isIncluded Boolean @default(true) @map("is_included")

  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([planId, moduleId])
  @@map("plan_modules")
  @@schema("public")
}

model TenantModule {
  id              String       @id @default(uuid()) @db.Uuid
  tenantId        String       @map("tenant_id") @db.Uuid
  moduleId        String       @map("module_id") @db.Uuid
  status          ModuleStatus @default(pending)
  activatedAt     DateTime?    @map("activated_at") @db.Timestamptz
  expiresAt       DateTime?    @map("expires_at") @db.Timestamptz
  activatedBy     String       @map("activated_by") @db.Uuid
  configOverrides Json         @default("{}") @map("config_overrides")
  notes           String?
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id])

  @@unique([tenantId, moduleId])
  @@index([tenantId])
  @@index([status])
  @@map("tenant_modules")
  @@schema("public")
}

model FeatureFlag {
  id           String   @id @default(uuid()) @db.Uuid
  key          String   @unique @db.VarChar(120)
  moduleId     String?  @map("module_id") @db.Uuid
  description  String?
  defaultValue Boolean  @default(false) @map("default_value")
  isGlobal     Boolean  @default(false) @map("is_global")
  rolloutPct   Int      @default(0) @map("rollout_pct") @db.SmallInt
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  module             Module?             @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  tenantFeatureFlags TenantFeatureFlag[]

  @@index([key])
  @@map("feature_flags")
  @@schema("public")
}

model TenantFeatureFlag {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  flagId    String    @map("flag_id") @db.Uuid
  value     Boolean
  setBy     String    @map("set_by") @db.Uuid
  reason    String?
  expiresAt DateTime? @map("expires_at") @db.Timestamptz
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  flag   FeatureFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)

  @@unique([tenantId, flagId])
  @@index([tenantId])
  @@map("tenant_feature_flags")
  @@schema("public")
}

model AdminUser {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(255)
  fullName     String    @map("full_name") @db.VarChar(255)
  role         AdminRole
  passwordHash String    @map("password_hash")
  totpSecret   String?   @map("totp_secret")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@map("admin_users")
  @@schema("public")
}

model AuditLog {
  id           String         @id @default(uuid()) @db.Uuid
  tenantId     String?        @map("tenant_id") @db.Uuid
  actorId      String         @map("actor_id") @db.Uuid
  actorType    AuditActorType @map("actor_type")
  action       String         @db.VarChar(120)
  resourceType String?        @map("resource_type") @db.VarChar(80)
  resourceId   String?        @map("resource_id") @db.Uuid
  payload      Json?
  ipAddress    String?        @map("ip_address")
  userAgent    String?        @map("user_agent")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt(sort: Desc)])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
  @@schema("public")
}

model LicenseKey {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  planId         String           @map("plan_id") @db.Uuid
  subscriptionId String?          @map("subscription_id") @db.Uuid
  keyHash        String           @unique @map("key_hash") @db.VarChar(128)
  keyPreview     String           @map("key_preview") @db.VarChar(32)
  period         BillingCycle
  status         LicenseKeyStatus @default(generated)
  issuedBy       String?          @map("issued_by") @db.Uuid
  redeemedBy     String?          @map("redeemed_by") @db.Uuid
  redeemedAt     DateTime?        @map("redeemed_at") @db.Timestamptz
  validFrom      DateTime?        @map("valid_from") @db.Timestamptz
  validUntil     DateTime?        @map("valid_until") @db.Timestamptz
  revokedAt      DateTime?        @map("revoked_at") @db.Timestamptz
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan         Plan          @relation(fields: [planId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([tenantId, status])
  @@index([subscriptionId])
  @@index([validUntil])
  @@map("license_keys")
  @@schema("public")
}

// =============================================================================
// 4. TENANT SCHEMA — Données métier (schema_template)
// =============================================================================

model Patient {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String?   @map("tenant_id") @db.Uuid
  ipp               String    @db.VarChar(20)
  lastName          String    @map("last_name") @db.VarChar(120)
  firstName         String    @map("first_name") @db.VarChar(120)
  maidenName        String?   @map("maiden_name") @db.VarChar(120)
  birthDate         DateTime  @map("birth_date") @db.Date
  birthPlace        String?   @map("birth_place") @db.VarChar(120)
  gender            Gender
  nationality       String    @default("CM") @db.Char(2)
  maritalStatus     String?   @map("marital_status") @db.VarChar(20)
  bloodGroup        String?   @map("blood_group") @db.VarChar(5)
  nss               String?   @unique @db.VarChar(30)
  phone             String?   @db.VarChar(30)
  email             String?   @db.VarChar(255)
  address           String?
  emergencyContact  Json      @default("{}") @map("emergency_contact")
  allergies         Json      @default("[]")
  chronicConditions Json      @default("[]") @map("chronic_conditions")
  gdprConsent       Boolean   @default(false) @map("gdpr_consent")
  gdprConsentAt     DateTime? @map("gdpr_consent_at") @db.Timestamptz
  isDeceased        Boolean   @default(false) @map("is_deceased")
  deceasedAt        DateTime? @map("deceased_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  stays              Stay[]
  appointments       Appointment[]
  medicalRecords     MedicalRecord[]
  prescriptions      Prescription[]
  examRequests       ExamRequest[]
  examResults        ExamResult[]
  surgicalProcedures SurgicalProcedure[]
  drugDispensings    DrugDispensing[]
  invoices           PatientInvoice[]
  adverseEvents      AdverseEvent[]
  vitalSigns         VitalSigns[]
  pregnancies        Pregnancy[]
  newbornRecord      Newborn?
  immunizations      Immunization[]
  malariaCases       MalariaCase[]
  tbCases            TbCase[]

  @@unique([tenantId, ipp])
  @@index([tenantId])
  @@index([birthDate])
  @@index([tenantId, lastName, firstName, birthDate])
  @@map("patients")
  @@schema("tenant_template")
}

model Stay {
  id                 String             @id @default(uuid()) @db.Uuid
  tenantId           String?            @map("tenant_id") @db.Uuid
  patientId          String             @map("patient_id") @db.Uuid
  stayNumber         String             @map("stay_number") @db.VarChar(20)
  type               StayType
  status             StayStatus         @default(in_progress)
  admissionDate      DateTime           @default(now()) @map("admission_date") @db.Timestamptz
  dischargeDate      DateTime?          @map("discharge_date") @db.Timestamptz
  departmentId       String?            @map("department_id") @db.Uuid
  bedId              String?            @map("bed_id") @db.Uuid
  attendingDoctorId  String?            @map("attending_doctor_id") @db.Uuid
  admissionReason    String?            @map("admission_reason")
  dischargeSummary   String?            @map("discharge_summary")
  pmsiCode           String?            @map("pmsi_code") @db.VarChar(20)
  pmsiValidated      Boolean            @default(false) @map("pmsi_validated")
  admissionTypeId    String?            @map("admission_type_id") @db.Uuid
  triageAcuity       TriageAcuity?      @map("triage_acuity")
  triagedAt          DateTime?          @map("triaged_at") @db.Timestamptz
  consultationStatus ConsultationStatus @default(waiting) @map("consultation_status")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  patient Patient @relation(fields: [patientId], references: [id])

  medicalRecords     MedicalRecord[]
  prescriptions      Prescription[]
  examRequests       ExamRequest[]
  surgicalProcedures SurgicalProcedure[]
  adverseEvents      AdverseEvent[]
  invoices           PatientInvoice[]
  vitalSigns         VitalSigns[]
  delivery           Delivery?

  @@unique([tenantId, stayNumber])
  @@index([tenantId])
  @@index([patientId])
  @@index([status])
  @@index([admissionDate(sort: Desc)])
  @@index([consultationStatus])
  @@map("stays")
  @@schema("tenant_template")
}

// A future-dated booking, distinct from Stay (which represents an actual physical
// visit already under way). Check-in (see /api/v1/appointments/[id]/check-in) creates
// a real Stay and links it back via stayId — from that point on the patient flows
// through the existing consultation queue / triage / billing pipeline unchanged, so
// nothing downstream of check-in needs to know appointments exist at all.
model Appointment {
  id                  String            @id @default(uuid()) @db.Uuid
  tenantId            String?           @map("tenant_id") @db.Uuid
  patientId           String            @map("patient_id") @db.Uuid
  doctorId            String            @map("doctor_id") @db.Uuid
  departmentId        String?           @map("department_id") @db.Uuid
  appointmentTypeCode String?           @map("appointment_type_code") @db.VarChar(40)
  scheduledAt         DateTime          @map("scheduled_at") @db.Timestamptz
  durationMinutes     Int               @default(30) @map("duration_minutes")
  status              AppointmentStatus @default(booked)
  reasonForVisit      String?           @map("reason_for_visit")
  notes               String?
  stayId              String?           @map("stay_id") @db.Uuid
  seriesId            String?           @map("series_id") @db.Uuid
  cancelledAt         DateTime?         @map("cancelled_at") @db.Timestamptz
  cancelledReason     String?           @map("cancelled_reason")
  createdBy           String?           @map("created_by") @db.Uuid
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([tenantId, doctorId, scheduledAt])
  @@index([tenantId, patientId])
  @@index([seriesId])
  @@index([status])
  @@map("appointments")
  @@schema("tenant_template")
}

// Recurring weekly availability window for a doctor's bookable appointment slots —
